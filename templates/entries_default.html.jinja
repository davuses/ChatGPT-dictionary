<tr>
    <th class="entry-col">Entry</th>
    <th class="context-col">Context</th>
    <th class="visit-col">Visit</th>
</tr>
{% for display in entry_displays %}
<tr id="{{ display.entry.id }}">
    <td class="entry-col"><label class="unselectable">-<span data-content=" "></span></label><a
            href="entry/{{ display.entry.id }}">{{ display.text }}</a></td>
    <td class="context-col">
        {{ display.context }}
    </td>
    <td class="visit-{{ display.entry.visit_count }}">{{ display.entry.visit_count }}</td>
</tr>
{% endfor %}
