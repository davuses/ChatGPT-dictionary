<colgroup>
    <col class="entry-col">
    <col class="context-col">
    <col class="visit-col">
</colgroup>
<thead>
    <tr>
        <th class="entry-col">{{ t('entries.col_entry') }}</th>
        <th class="context-col">{{ t('entries.col_context') }}</th>
        <th class="visit-col">{{ t('entries.col_visits') }}</th>
    </tr>
</thead>
<tbody>
{% for display in entry_displays %}
{% set vc = display.entry.visit_count %}
{% set visit_tier = "visit-0" if vc == 0 else ("visit-low" if vc <= 2 else ("visit-mid" if vc <= 4 else "visit-high")) %}
<tr id="{{ display.entry.id }}">
    <td class="entry-col">
        <div class="entry-cell-head">
            <button type="button" class="audio-btn audio-btn--sm" data-word="{{ display.raw_word }}" aria-label="{{ t('entries.play_aria', word=display.raw_word) }}">
                <svg class="icon-play" aria-hidden="true"><use href="#icon-audio-play"/></svg>
                <svg class="icon-pause" aria-hidden="true"><use href="#icon-audio-pause"/></svg>
            </button>
            <a href="/entry/{{ display.entry.id }}">{{ display.text }}</a>
        </div>
    </td>
    <td class="context-col">{{ display.context }}</td>
    <td class="visit-col {{ visit_tier }}" data-label="{{ t('entries.col_visits') }}">{{ vc }}</td>
</tr>
{% endfor %}
</tbody>
