<tr>
    <th>Question</th>
    <th>Context</th>
    <th>Action</th>
    <th>Visit</th>
</tr>
{% for q_tuple in q_tuples %}
<tr id="{{ q_tuple[0] }}">
    <td><label class="unselectable">-<span data-content=" "></span></label><a style="text-decoration: none;"
            href="question/{{ q_tuple[0] }}">{{ q_tuple[1] }}</a></td>
    <td>
        {{ q_tuple[2] }}
    </td>
    <td><button onclick="deleteQuestionMainPageByButton(this, {{ q_tuple[0] }})">Delete</button></td>
    <td class="visit-{{ q_tuple[4] }}">{{ q_tuple[4] }}</td>
</tr>
{% endfor %}