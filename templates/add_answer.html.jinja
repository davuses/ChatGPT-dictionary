{% extends "base.html.jinja" %}
{% block title %} Add Answer {% endblock title %}

{% block body %}
<h1>Add Answer</h1>
<form method="post"
    action="/add_answer">
    <textarea name="answer_text"></textarea><br>
    <input value="{{ entry_id }}"
        name="entry_id"
        type="hidden">
    <input type="submit"
        value="Submit">
</form>
{% endblock body %}