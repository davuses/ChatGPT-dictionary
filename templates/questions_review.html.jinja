<tr>
    <th>Question</th>
    <th>Context</th>
    <th>Visit</th>
    <th>Mark</th> <!-- New header -->
</tr>
{% for QD in q_list %}
<tr id="{{ QD.question.id }}">
    <td class="col-1"><label class="unselectable">-<span data-content=" "></span></label><a
            style="text-decoration: none;"
            href="question/{{ QD.question.id }}">{{ QD.q_text }}</a></td>
    <td class="col-2">
        {{ QD.q_context }}
    </td>
    <td class="visit-{{ QD.question.visit_count }}">{{ QD.question.visit_count }}</td>
    <td style="color: #305969; font-size: medium; font-family: monospace; margin: 0px;"">
        {% if QD.last_review_elapse != "never"%}
        review: {{ QD.last_review_elapse }}
        {% else %}
        <!-- Empty cell if no last_review -->
        {% endif %}
    </td>
</tr>
{% endfor %}
{% if last_review_question_id %}
<a href="#{{last_review_question_id}}" style="font-style: italic; ">last review</a>
{% endif %}