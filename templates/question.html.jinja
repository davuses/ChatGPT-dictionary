{% extends "base.html.jinja" %}
{% block title %} {{ word }} {% endblock title %}
{% block body %}

<link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />
<style>
    .material-symbols-outlined {
        font-size: 32px;
        font-variation-settings:
            'FILL' 0,
            'wght' 400,
            'GRAD' 0,
            'opsz' 24
    }

    .audio-icon {
        cursor: pointer;
        user-select: none;
    }

    .audio-icon:hover {
        color: #306e9b;
    }
</style>

<body>
    <p>
        <a class="header-link"
            href="/">Back to Main Page</a>
        <a class="header-link"
            href="/add_question">Add Question</a>
    </p>
    <article>
        <h1 style="font-size: 31px; text-align: center"> {{ word }} </h1>
        <p style="display: flex; justify-content: space-between;
                   color: #305969; font-size: medium; font-family: monospace; margin: 0px;">
            <span>Visit count: {{ visit_count }}</span>
            <span>Last visit: {{ how_long_ago }}</span>
        </p>
        <h2>Question</h2>
        <p id="question">{{ question_text }}</p>
        <button class="q-button"
            onclick="location.href='/edit_question/{{ question_id }}'"
            type="button">Edit</button>
        <button class="q-button"
            onclick="deleteQuestion({{ question_id }})"
            type="button"
            id="dbt">Delete</button>
        <hr>
        <p class="IPA-player">
            /{{ IPA_transcript }}/

            <audio id="1-ipa-audio"
                controls
                style="display: none;"
                class="ipa-audio"
                oncanplay="myOnCanPlayFunction(this)">
                <source src="
                    https://ssl.gstatic.com/dictionary/static/sounds/oxford/{{ word }}--_us_1.mp3"
                    type="audio/mp3">
                <source src="
                    https://ssl.gstatic.com/dictionary/static/sounds/oxford/x{{ word }}--_us_1.mp3"
                    type="audio/mp3">
            </audio>
            <span class="material-symbols-outlined audio-icon"
                id="audio-icon-1"
                style="display: none; margin-left: 10px;"
                onclick="toggleAudio(this)">
                play_circle
            </span>

            <audio id="2-ipa-audio"
                controls
                style="display: none;"
                class="ipa-audio"
                oncanplay="myOnCanPlayFunction(this)">
                <source id="2nd-ipa-source"
                    src="
                    https://ssl.gstatic.com/dictionary/static/sounds/oxford/{{ word }}--_us_2.mp3"
                    type="audio/mp3">
            </audio>
            <span class="material-symbols-outlined audio-icon"
                id="audio-icon-2"
                style="display: none; margin-left: 10px;"
                onclick="toggleAudio(this)">
                play_circle
            </span>

            <audio id="google-translate-audio"
                controls
                style="display: none;"
                oncanplay="check_IPA_audio()">
                <source
                    src="
                    https://www.google.com/speech-api/v1/synthesize?text={{ word }}&enc=mpeg&lang=en-us&speed=0.45&client=lr-language-tts&use_google_only_voices=1"
                    type="audio/mp3">
            </audio>
            <span class="material-symbols-outlined audio-icon"
                style="display: none; margin-left: 10px;"
                id="google-translate-audio-icon"
                onclick="toggleGoogleTranslateAudio(this)">
                play_circle
            </span>

            <script>
                function toggleAudio(icon) {
                    const audioId = icon.id[icon.id.length - 1]
                    const audio = document.getElementById(audioId + "-ipa-audio");
                    if (audio.paused) {
                        audio.play();
                        icon.innerHTML = 'pause_circle'; // Change to pause icon

                    } else {
                        audio.pause();
                        icon.innerHTML = 'play_circle'; // Change to play icon

                    }
                }
                function toggleGoogleTranslateAudio(icon) {
                    const audio = document.getElementById("google-translate-audio");
                    if (audio.paused) {
                        audio.play();
                        icon.innerHTML = 'pause_circle'; // Change to pause icon

                    } else {
                        audio.pause();
                        icon.innerHTML = 'play_circle'; // Change to play icon

                    }
                }
                const audioElements = document.querySelectorAll('audio');
                audioElements.forEach((audio, index) => {
                    let icon
                    if (audio.id == "google-translate-audio") {
                        icon = document.getElementById("google-translate-audio-icon")
                    } else {
                        const audioId = audio.id[0];
                        icon = document.getElementById("audio-icon-" + audioId);
                    }
                    audio.addEventListener('ended', () => {
                        icon.innerHTML = 'play_circle';
                    });
                })
                function myOnCanPlayFunction(audio) {
                    const audioId = audio.id[0];
                    if (audio) {
                        if (audio.readyState) {
                            const icon = document.getElementById("audio-icon-" + audioId);
                            icon.style.display = "inline";
                        }
                    }
                }
                function check_IPA_audio() {
                    const audioIPAElements = document.querySelectorAll('.ipa-audio');
                    if (!audioElements[0].readyState && !audioElements[1].readyState) {
                        const icon = document.getElementById("google-translate-audio-icon")
                        icon.style.display = "inline";
                    }
                }
                document.addEventListener("keydown", (event) => {
                    if (event.key === "p") {
                        let audioElems;
                        const ipaAudios = document.querySelectorAll('.ipa-audio');
                        if (!ipaAudios[0].readyState && !ipaAudios[1].readyState) {
                            audioElems = [document.getElementById("google-translate-audio")]
                        } else { audioElems = ipaAudios }
                        let preAudio;
                        audioElems.forEach((audio, index) => {
                            let duration = 0;
                            if (typeof preAudio !== 'undefined') {
                                duration = preAudio.duration
                            }
                            setTimeout(function () {
                                audio.play(); // Play the audio after the duration
                            }, duration * 1000);
                            preAudio = audio
                        })
                    }
                })
                document.addEventListener("keydown", (event) => {
                    if (event.altKey && event.key === "v") {
                        event.preventDefault();
                        const answerDiv = document.getElementById("answer-div");
                        if (!answerDiv) {
                            navigator.clipboard
                                .readText()
                                .then((text) => {
                                    const answerForm = document.createElement("form");
                                    answerForm.method = "post";
                                    answerForm.action = "/add_answer";
                                    let formData = { question_id: questionId, answer_text: text };
                                    for (const key in formData) {
                                        const hiddenField = document.createElement("input");
                                        hiddenField.type = "hidden";
                                        hiddenField.name = key;
                                        hiddenField.value = formData[key];
                                        answerForm.appendChild(hiddenField);
                                    }
                                    document.body.appendChild(answerForm);
                                    answerForm.submit();
                                })
                                .catch((error) => {
                                    console.error("Failed to read clipboard: ", error);
                                });
                        }
                    } else if (event.key === "b") {
                        let length = history.length;
                        for (step = length - 1; step > 0; step--) {
                            history.back(step);
                        }
                    } else if (event.key === "e") {
                        document.getElementById("edit-example").click();
                    } else if (event.key === "D") {
                        document.getElementById("dbt").click();
                    } else if (event.key === "a") {
                        window.open("/add_question", "_blank").focus();
                    } else if (event.key === "Q") {
                        const textToCopy = document.getElementById('question').innerText;
                        navigator.clipboard.writeText(textToCopy).then(() => {
                            console.log('Text copied to clipboard!');
                        }).catch(err => {
                            console.error('Failed to copy text: ', err);
                        });
                    } else if (event.key === "A") {
                        window.location.href = "/add_question";
                    }
                });
                function deleteAnswer(button, answerId) {
                    if (confirm("Are you sure you want to delete this answer?")) {
                        fetch("/delete_answer/" + answerId).then((Response) => {
                            if (Response.ok) {
                                var a_li = button.parentNode;
                                var a_ul = a_li.parentNode;
                                a_ul.removeChild(a_li);
                            }
                        });
                    }
                }


                var questionId = "{{ question_id }}"
            </script>
        </p>
        <div id="tts-div"
            style="display: none;">
            <audio controls
                class="svelte-eemfgq"
                oncanplay="ttsCanPlay()">
            </audio>
            <button class="q-button"
                onclick="deleteAudio({{ question_id }})"
                type="button">Delete audio</button>
        </div>
        <h2>Answer</h2>
        <button class="q-button"
            onclick="location.href='/add_answer?qid={{ question_id }}'"
            type="button">Add answer</button>
        {% if answer_exist %}
        <div id="answer-div">
            {{ answer_html | safe }}
            <button class="q-button"
                onclick="location.href='/edit_answer/{{ answer_id }}'"
                type="button">Edit</button>
            <button class="q-button"
                onclick="deleteAnswer(this,{{ answer_id }})">Delete</button>
        </div>
        {% endif %}
        <h2>Example</h2>
        <p>{{ example_html | safe }}</p>
        <button class="q-button"
            onclick="location.href='/edit_example/{{ question_id }}'"
            type="button"
            id="edit-example">
            Edit example</button>
        <h2>Synonyms</h2>
        <a href='/show_synonyms/{{ question_id }}'>Show synonyms</a>
        <br><br><br><br>
    </article>
</body>

{% endblock body %}