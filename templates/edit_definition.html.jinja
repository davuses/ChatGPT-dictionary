{% extends "base.html.jinja" %}
{% from "_page_header.html.jinja" import page_header %}
{% block title %}Edit Definition{% endblock title %}

{% block body %}
{% set entry_link %}<a class="button button-ghost" href="/entry/{{ entry_id }}">Entry</a>{% endset %}
{{ page_header(extra_nav=entry_link) }}
<main class="form-page">
<h1>Edit Definition</h1>
<form method="post"
    action="/edit_definition/{{ definition_id }}">
    <textarea name="definition_text">{{ definition_text }}</textarea><br>
    <div class="form-actions">
        <input type="submit"
            value="Submit">
    </div>
</form>
</main>
{% endblock body %}
