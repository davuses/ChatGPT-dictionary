{% extends "base.html.jinja" %}
{% from "_page_header.html.jinja" import page_header with context %}
{% block title %}{{ t('form.edit_def_title') }}{% endblock title %}

{% block body %}
{% set entry_link %}<a class="button button-ghost" href="/entry/{{ entry_id }}">{{ t('nav.entry') }}</a>{% endset %}
{{ page_header(extra_nav=entry_link) }}
<main class="form-page">
<h1>{{ t('form.edit_def_title') }}</h1>
<form method="post"
    action="/edit_definition/{{ definition_id }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <textarea class="markdown-editor" name="definition_text">{{ definition_text }}</textarea><br>
    <div class="form-actions">
        <input type="submit"
            value="{{ t('form.submit') }}">
        <a class="button button-ghost" href="/entry/{{ entry_id }}">{{ t('form.cancel') }}</a>
    </div>
</form>
</main>
{% endblock body %}
