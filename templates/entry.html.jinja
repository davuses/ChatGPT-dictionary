{% extends "base.html.jinja" %}
{% block title %} {{ word }} {% endblock title %}

{% block head %}
<link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />
<style>
    .material-symbols-outlined {
        font-size: 32px;
        font-variation-settings:
            'FILL' 0,
            'wght' 400,
            'GRAD' 0,
            'opsz' 24
    }

    .audio-icon {
        cursor: pointer;
        user-select: none;
    }

    .audio-icon:hover {
        color: var(--accent-dark);
    }
</style>
{% endblock head %}

{% block body %}
    <nav class="page-toolbar" aria-label="Entry actions">
        <div class="page-toolbar-actions">
            <a class="button button-ghost" href="/entries">Dictionary</a>
            <a class="button button-ghost" href="/show_synonyms/{{ entry_id }}">Synonyms</a>
        </div>
        <a class="button button-primary" href="/add_entry">Add</a>
    </nav>
    <article class="entry-page">
        <h1 class="word-title"> {{ word }} </h1>
        <p class="word-meta">
            <span>{{ visit_count }} visits</span>
            <span>Last visit: {{ last_visit_elapsed }}</span>
            <span class="flex-center">
                {% if is_review_bookmark %}
                <span>Resume point</span>
                <button class="button-danger" id="clear-review-bookmark" onclick="handleClearReviewBookmark()">Clear</button>
                {% else %}
                <button id="set-review-bookmark" onclick="handleSetReviewBookmark()">Mark here</button>
                {% endif %}
            </span>
        </p>
        <div class="pronunciation-row IPA-player">
            /{{ IPA_transcript }}/

            <audio id="1-ipa-audio"
                controls
                style="display: none;"
                class="ipa-audio"
                oncanplay="myOnCanPlayFunction(this)">
                <source src="
                    https://ssl.gstatic.com/dictionary/static/sounds/oxford/{{ word }}--_us_1.mp3"
                    type="audio/mp3">
                <source src="
                    https://ssl.gstatic.com/dictionary/static/sounds/oxford/x{{ word }}--_us_1.mp3"
                    type="audio/mp3">
            </audio>
            <span class="material-symbols-outlined audio-icon"
                id="audio-icon-1"
                style="display: none; margin-left: 10px;"
                onclick="toggleAudio(this)">
                play_circle
            </span>

            <audio id="2-ipa-audio"
                controls
                style="display: none;"
                class="ipa-audio"
                oncanplay="myOnCanPlayFunction(this)">
                <source id="2nd-ipa-source"
                    src="
                    https://ssl.gstatic.com/dictionary/static/sounds/oxford/{{ word }}--_us_2.mp3"
                    type="audio/mp3">
            </audio>
            <span class="material-symbols-outlined audio-icon"
                id="audio-icon-2"
                style="display: none; margin-left: 10px;"
                onclick="toggleAudio(this)">
                play_circle
            </span>

            <audio id="google-translate-audio"
                controls
                style="display: none;"
                oncanplay="check_IPA_audio()">
                <source
                    src="
                    https://www.google.com/speech-api/v1/synthesize?text={{ word }}&enc=mpeg&lang=en-us&speed=0.45&client=lr-language-tts&use_google_only_voices=1"
                    type="audio/mp3">
            </audio>
            <span class="material-symbols-outlined audio-icon"
                style="display: none; margin-left: 10px;"
                id="google-translate-audio-icon"
                onclick="toggleGoogleTranslateAudio(this)">
                play_circle
            </span>

            <script>
                function toggleAudio(icon) {
                    const audioId = icon.id[icon.id.length - 1]
                    const audio = document.getElementById(audioId + "-ipa-audio");
                    if (audio.paused) {
                        audio.play();
                        icon.innerHTML = 'pause_circle'; // Change to pause icon

                    } else {
                        audio.pause();
                        icon.innerHTML = 'play_circle'; // Change to play icon

                    }
                }
                function toggleGoogleTranslateAudio(icon) {
                    const audio = document.getElementById("google-translate-audio");
                    if (audio.paused) {
                        audio.play();
                        icon.innerHTML = 'pause_circle'; // Change to pause icon

                    } else {
                        audio.pause();
                        icon.innerHTML = 'play_circle'; // Change to play icon

                    }
                }
                const audioElements = document.querySelectorAll('audio');
                audioElements.forEach((audio, index) => {
                    let icon
                    if (audio.id == "google-translate-audio") {
                        icon = document.getElementById("google-translate-audio-icon")
                    } else {
                        const audioId = audio.id[0];
                        icon = document.getElementById("audio-icon-" + audioId);
                    }
                    audio.addEventListener('ended', () => {
                        icon.innerHTML = 'play_circle';
                    });
                })
                function myOnCanPlayFunction(audio) {
                    const audioId = audio.id[0];
                    if (audio) {
                        if (audio.readyState) {
                            const icon = document.getElementById("audio-icon-" + audioId);
                            icon.style.display = "inline";
                        }
                    }
                }
                function check_IPA_audio() {
                    const audioIPAElements = document.querySelectorAll('.ipa-audio');
                    if (!audioElements[0].readyState && !audioElements[1].readyState) {
                        const icon = document.getElementById("google-translate-audio-icon")
                        icon.style.display = "inline";
                    }
                }
                document.addEventListener("keydown", (event) => {
                    if (event.key === "p") {
                        let audioElems;
                        const ipaAudios = document.querySelectorAll('.ipa-audio');
                        if (!ipaAudios[0].readyState && !ipaAudios[1].readyState) {
                            audioElems = [document.getElementById("google-translate-audio")]
                        } else { audioElems = ipaAudios }
                        let preAudio;
                        audioElems.forEach((audio, index) => {
                            let duration = 0;
                            if (typeof preAudio !== 'undefined') {
                                duration = preAudio.duration
                            }
                            setTimeout(function () {
                                audio.play(); // Play the audio after the duration
                            }, duration * 1000);
                            preAudio = audio
                        })
                    }
                })
                document.addEventListener("keydown", (event) => {
                    if (event.altKey && event.key === "v") {
                        event.preventDefault();
                        const definitionDiv = document.getElementById("definition-div");
                        if (!definitionDiv) {
                            navigator.clipboard
                                .readText()
                                .then((text) => {
                                    const definitionForm = document.createElement("form");
                                    definitionForm.method = "post";
                                    definitionForm.action = "/add_definition";
                                    let formData = { entry_id: entryId, definition_text: text };
                                    for (const key in formData) {
                                        const hiddenField = document.createElement("input");
                                        hiddenField.type = "hidden";
                                        hiddenField.name = key;
                                        hiddenField.value = formData[key];
                                        definitionForm.appendChild(hiddenField);
                                    }
                                    document.body.appendChild(definitionForm);
                                    definitionForm.submit();
                                })
                                .catch((error) => {
                                    console.error("Failed to read clipboard: ", error);
                                });
                        }
                    } else if (event.key === "b") {
                        let length = history.length;
                        for (step = length - 1; step > 0; step--) {
                            history.back(step);
                        }
                    } else if (event.key === "e") {
                        document.getElementById("edit-example").click();
                    } else if (event.key === "D") {
                        document.getElementById("dbt").click();
                    } else if (event.key === "a") {
                        window.open("/add_entry", "_blank").focus();
                    } else if (event.key === "Q") {
                        const textToCopy = document.getElementById('entry').innerText;
                        navigator.clipboard.writeText(textToCopy).then(() => {
                            console.log('Text copied to clipboard!');
                        }).catch(err => {
                            console.error('Failed to copy text: ', err);
                        });
                    } else if (event.key === "A") {
                        window.location.href = "/add_entry";
                    }
                });
                function deleteDefinition(button, definitionId) {
                    if (confirm("Are you sure you want to delete this definition?")) {
                        fetch("/delete_definition/" + definitionId, { method: "DELETE" }).then((Response) => {
                            if (Response.ok) {
                                location.reload();
                            }
                        });
                    }
                }

                function handleSetReviewBookmark() {
                    fetch('/entry/{{ entry_id }}/set_review_bookmark', { method: 'POST' })
                        .then(response => {
                            if (response.ok) location.reload();
                            else alert('Failed to set resume point.');
                        });
                }

                function handleClearReviewBookmark() {
                    fetch('/entry/{{ entry_id }}/clear_review_bookmark', { method: 'POST' })
                        .then(response => {
                            if (response.ok) location.reload();
                            else alert('Failed to clear resume point.');
                        });
                }
                var entryId = "{{ entry_id }}"
            </script>
        </div>
        <section class="content-section">
            <div class="section-header">
                <h2>Entry</h2>
                <div class="section-actions">
                    <button class="entry-button"
                        onclick="location.href='/edit_entry/{{ entry_id }}'"
                        type="button">Edit</button>
                    <button class="entry-button button-danger"
                        onclick="deleteEntry({{ entry_id }})"
                        type="button"
                        id="dbt">Delete</button>
                </div>
            </div>
            <p class="entry-value" id="entry">{{ entry_text }}</p>
        </section>
        <section class="content-section">
            <div class="section-header">
                <h2>Definition</h2>
                {% if definition_exists %}
                <div class="section-actions">
                    <button class="entry-button"
                        onclick="location.href='/edit_definition/{{ definition_id }}'"
                        type="button">Edit</button>
                    <button class="entry-button button-danger"
                        onclick="deleteDefinition(this,{{ definition_id }})">Delete</button>
                </div>
                {% endif %}
            </div>
        {% if not definition_exists %}
        <button class="entry-button"
            onclick="location.href='/add_definition?entry_id={{ entry_id }}'"
            type="button">Add definition</button>
        {% endif %}
        {% if definition_exists %}
        <div id="definition-div">
            {{ definition_html | safe }}
        </div>
        {% endif %}
        </section>
        <section class="content-section">
            <div class="section-header">
                <h2>Example</h2>
                <button class="entry-button"
                    onclick="location.href='/edit_example/{{ entry_id }}'"
                    type="button"
                    id="edit-example">
                    Edit</button>
            </div>
            <div>{{ example_html | safe }}</div>
        </section>
    </article>

{% endblock body %}
