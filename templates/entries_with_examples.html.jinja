<tr>
    <th>Entry</th>
    <th>Context</th>
    <th>Examples</th>
</tr>
{% for QD in q_list %}
<tr id="{{ QD.entry.id }}">
    <td class="col-1"><label class="unselectable">-<span data-content=" "></span></label><a
            href="entry/{{ QD.entry.id }}">{{ QD.q_text }}</a></td>
    <td class="col-2">
        {{ QD.q_context }}
    </td>
    {% if show_example %}
    <td class="col-2"> {{ QD.entry.example }} </td>
    {% endif %}
</tr>
{% endfor %}