{% extends "base.html.jinja" %}
{% from "_page_header.html.jinja" import page_header with context %}
{% block title %}{{ t('inbox.title') }}{% endblock title %}
{% block body_class %}page-narrow{% endblock body_class %}

{% macro format_ts(sec) -%}
{%- set h = sec // 3600 -%}
{%- set m = (sec % 3600) // 60 -%}
{%- set s = sec % 60 -%}
{%- if h > 0 %}{{ h }}:{{ "%02d"|format(m) }}:{{ "%02d"|format(s) }}{% else %}{{ m }}:{{ "%02d"|format(s) }}{% endif -%}
{%- endmacro %}

{% block body %}
{% set ext_nav_link %}<a class="button button-ghost" href="/account#extension">{{ t('inbox.ext_link', version=extension_version) }}</a>{% endset %}
{{ page_header(subtitle=t('inbox.subtitle'), active="inbox", extra_nav=ext_nav_link, show_add=True) }}

<main class="inbox-page" id="inbox-main">
    <div class="inbox-toolbar" id="inbox-toolbar"{% if not promoted_count %} hidden{% endif %}>
        <button type="button" class="button button-ghost" id="inbox-clear-promoted">
            {{ t('inbox.clear_promoted', n=promoted_count) }}
        </button>
    </div>

    <section class="card" id="inbox-empty-card"{% if page_notes %} hidden{% endif %}>
        <h2>{{ t('inbox.empty_title') }}</h2>
        <p>{{ t('inbox.empty_desc') }}</p>
        <div class="form-actions">
            <a class="button button-primary" href="/account#extension">{{ t('inbox.install_ext') }}</a>
            <a class="button button-ghost" href="{{ extension_download_url }}" target="_blank" rel="noopener noreferrer">{{ t('inbox.download_zip') }}</a>
        </div>
    </section>

    {% for note in page_notes %}
    {% set unpromoted = note.items | selectattr("promoted_entry_id", "none") | list %}
    <section class="card inbox-note-card"
        data-note-id="{{ note.id }}"
        data-note-url="{{ note.url }}"
        data-note-title="{{ note.title }}">
        <div class="inbox-note-header">
            <div class="inbox-note-meta">
                <h2 class="inbox-note-title">
                    <a href="{{ note.url }}" target="_blank" rel="noopener noreferrer">{{ note.title or note.url }}</a>
                </h2>
                <p class="inbox-note-url">{{ note.url }}</p>
            </div>
            <div class="inbox-note-actions">
                <button type="button"
                    class="button button-ghost inbox-collapse-btn"
                    aria-expanded="true"
                    aria-controls="inbox-note-body-{{ note.id }}">
                    {{ t('inbox.collapse') }}
                </button>
                <button type="button"
                    class="button button-primary inbox-promote-all"
                    data-item-ids="{{ unpromoted | map(attribute='id') | join(',') }}"{% if not unpromoted %} hidden{% endif %}>
                    {{ t('inbox.add_all', n=unpromoted | length) }}
                </button>
                <button type="button"
                    class="button button-danger inbox-delete-note"
                    data-note-id="{{ note.id }}">
                    {{ t('inbox.delete_page') }}
                </button>
            </div>
        </div>

        <div class="inbox-note-body" id="inbox-note-body-{{ note.id }}">
        {% if note.items %}
        <ul class="inbox-item-list">
            {% for item in note.items %}
            {% set existing_ids = all_words.get(item.word.strip().lower(), []) %}
            <li class="inbox-item{% if item.promoted_entry_id %} is-promoted{% endif %}"
                data-item-id="{{ item.id }}"
                data-word="{{ item.word }}"
                data-context="{{ item.context }}"
                data-definition="{{ item.definition_text }}">
                <div class="inbox-item-main">
                    <div class="inbox-item-head">
                        <strong class="inbox-item-word">{{ item.word }}</strong>
                        {% set item_ipa = item_ipas.get(item.word, "") %}
                        {% if item_ipa %}
                        <span class="ipa inbox-item-ipa">/{{ item_ipa }}/</span>
                        {% endif %}
                        <button type="button"
                            class="audio-btn audio-btn--sm inbox-audio-btn"
                            data-word="{{ item.word }}"
                            aria-label="{{ t('inbox.play_aria', word=item.word) }}"
                            title="{{ t('inbox.play_title') }}">
                            <svg class="icon-play" aria-hidden="true"><use href="#icon-audio-play"/></svg>
                            <svg class="icon-pause" aria-hidden="true"><use href="#icon-audio-pause"/></svg>
                        </button>
                        {% if item.timestamp_seconds is not none %}
                        {% set ts_url = note.url ~ ("&t=" if "?" in note.url else "?t=") ~ item.timestamp_seconds %}
                        <a class="inbox-ts-badge" href="{{ ts_url }}" target="_blank" rel="noopener noreferrer">{{ format_ts(item.timestamp_seconds) }}</a>
                        {% endif %}
                        {% if item.promoted_entry_id %}
                        <a class="inbox-promoted-badge" href="/entry/{{ item.promoted_entry_id }}">{{ t('inbox.added_badge') }}</a>
                        {% elif existing_ids %}
                        {% for eid in existing_ids %}
                        <a class="inbox-existing-badge" href="/entry/{{ eid }}">{{ t('inbox.in_dict_badge') }}{% if existing_ids | length > 1 %} #{{ loop.index }}{% endif %}</a>
                        {% endfor %}
                        {% endif %}
                    </div>
                    <p class="inbox-item-context"{% if not item.context %} hidden{% endif %}>{{ item.context }}</p>
                    <p class="inbox-item-def"{% if not item.definition_text %} hidden{% endif %}>{{ item.definition_text }}</p>
                    <div class="inbox-dict-links">
                        <a class="inbox-dict-link" href="https://www.google.com/search?q={{ ('define ' ~ item.word) | urlencode }}" target="_blank" rel="noopener noreferrer">Google</a>
                        <a class="inbox-dict-link" href="https://www.oxfordlearnersdictionaries.com/search/english/?q={{ item.word | urlencode }}" target="_blank" rel="noopener noreferrer">Oxford</a>
                        <a class="inbox-dict-link" href="https://www.ldoceonline.com/search/english/direct/?q={{ item.word | urlencode }}" target="_blank" rel="noopener noreferrer">Longman</a>
                        <a class="inbox-dict-link" href="https://www.merriam-webster.com/dictionary/{{ item.word | urlencode }}" target="_blank" rel="noopener noreferrer">MW</a>
                    </div>
                    <div class="inbox-lookup-panel" hidden></div>
                    <p class="inbox-item-error form-error" role="alert" hidden></p>
                    <form class="inbox-edit-form" hidden>
                        <label class="inbox-edit-label">
                            <span>{{ t('inbox.word_label') }}</span>
                            <input type="text" name="word" value="{{ item.word }}" required>
                        </label>
                        <label class="inbox-edit-label">
                            <span>{{ t('inbox.context_label') }}</span>
                            <textarea name="context" rows="2">{{ item.context }}</textarea>
                        </label>
                        <label class="inbox-edit-label">
                            <span>{{ t('inbox.def_label') }}</span>
                            <textarea name="definition_text" rows="2" placeholder="{{ t('inbox.def_placeholder') }}">{{ item.definition_text }}</textarea>
                        </label>
                        <div class="inbox-edit-actions">
                            <button type="submit" class="button button-primary">{{ t('inbox.save') }}</button>
                            <button type="button" class="button button-ghost inbox-edit-cancel">{{ t('inbox.cancel') }}</button>
                        </div>
                    </form>
                </div>
                <div class="inbox-item-actions">
                    {% if not item.promoted_entry_id %}
                    <button type="button" class="button button-ghost inbox-lookup-toggle">{{ t('inbox.lookup') }}</button>
                    <button type="button" class="button button-ghost inbox-edit-toggle">{{ t('entry.edit') }}</button>
                    <button type="button" class="button button-ghost inbox-promote-one" data-item-id="{{ item.id }}">{{ t('inbox.add_one') }}</button>
                    {% endif %}
                    <button type="button" class="button button-danger inbox-delete-one" data-item-id="{{ item.id }}">{{ t('entry.delete') }}</button>
                </div>
            </li>
            {% endfor %}
        </ul>
        {% endif %}

        <details class="inbox-scratchpad"{% if note.notes_md %} open{% endif %}>
            <summary>{{ t('inbox.scratchpad_title') }}</summary>
            <div class="inbox-scratchpad-editor">
                <textarea class="inbox-scratchpad-input" rows="4" placeholder="{{ t('inbox.scratchpad_placeholder') }}">{{ note.notes_md }}</textarea>
                <div class="inbox-scratchpad-actions">
                    <button type="button" class="button button-ghost inbox-save-notes">{{ t('inbox.save_notes') }}</button>
                    <span class="inbox-scratchpad-status" aria-live="polite"></span>
                </div>
            </div>
        </details>
        </div>
    </section>
    {% endfor %}
</main>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const emptyCard = document.getElementById("inbox-empty-card");
    const toolbar = document.getElementById("inbox-toolbar");
    const clearPromotedBtn = document.getElementById("inbox-clear-promoted");

    function syncInboxCounters() {
        const cards = document.querySelectorAll(".inbox-note-card");
        if (emptyCard) emptyCard.hidden = cards.length > 0;

        let totalPending = 0;
        let totalPromoted = 0;

        cards.forEach((card) => {
            const unpromotedItems = Array.from(card.querySelectorAll(".inbox-item:not(.is-promoted)"));
            const promotedItems = card.querySelectorAll(".inbox-item.is-promoted");
            totalPending += unpromotedItems.length;
            totalPromoted += promotedItems.length;

            const addAllBtn = card.querySelector(".inbox-promote-all");
            if (addAllBtn) {
                const ids = unpromotedItems.map((li) => li.dataset.itemId).filter(Boolean);
                addAllBtn.dataset.itemIds = ids.join(",");
                addAllBtn.hidden = ids.length === 0;
                addAllBtn.disabled = false;
                if (ids.length > 0) {
                    addAllBtn.textContent = uiText("inbox_add_all", { n: ids.length }, "Add all (" + ids.length + ")");
                }
            }
        });

        if (toolbar && clearPromotedBtn) {
            toolbar.hidden = totalPromoted === 0;
            clearPromotedBtn.disabled = false;
            if (totalPromoted > 0) {
                clearPromotedBtn.textContent = uiText(
                    "inbox_clear_promoted",
                    { n: totalPromoted },
                    "Clear promoted (" + totalPromoted + ")"
                );
            }
        }

        const navBadge = document.getElementById("nav-inbox-badge");
        if (navBadge) {
            if (totalPending > 0) {
                navBadge.textContent = String(totalPending);
                navBadge.hidden = false;
            } else {
                navBadge.remove();
            }
        }
    }

    function showItemError(itemId, message) {
        const li = document.querySelector('.inbox-item[data-item-id="' + itemId + '"]');
        if (!li) return;
        const errEl = li.querySelector(".inbox-item-error");
        if (!errEl) return;
        errEl.textContent = message || "";
        errEl.hidden = !message;
    }

    function markItemPromoted(itemId, entryId) {
        const li = document.querySelector('.inbox-item[data-item-id="' + itemId + '"]');
        if (!li) return;
        li.classList.add("is-promoted");
        showItemError(itemId, "");
        li.querySelectorAll(".inbox-promote-one, .inbox-edit-toggle, .inbox-lookup-toggle, .inbox-existing-badge").forEach((el) => el.remove());
        const editForm = li.querySelector(".inbox-edit-form");
        if (editForm) editForm.hidden = true;
        const lookupPanel = li.querySelector(".inbox-lookup-panel");
        if (lookupPanel) lookupPanel.hidden = true;
        const head = li.querySelector(".inbox-item-head");
        if (head && entryId && !head.querySelector(".inbox-promoted-badge")) {
            const link = document.createElement("a");
            link.className = "inbox-promoted-badge";
            link.href = "/entry/" + encodeURIComponent(entryId);
            link.textContent = uiText("inbox_added", null, "Added \u2192");
            head.appendChild(link);
        }
    }

    function promoteIds(itemIds, triggerBtn) {
        if (triggerBtn) triggerBtn.disabled = true;
        itemIds.forEach((id) => showItemError(id, ""));
        fetchJson("/api/v1/page-note/promote", {
            method: "POST",
            headers: Object.assign({ "Content-Type": "application/json" }, csrfHeaders()),
            body: JSON.stringify({ item_ids: itemIds }),
        })
            .then((data) => {
                const results = (data && data.results) || [];
                let okCount = 0;
                results.forEach((r) => {
                    if (r.status === "error") {
                        showItemError(r.item_id, r.error || uiText("inbox_err_add", null, "Could not add this word."));
                    } else if (r.status === "not_found") {
                        showItemError(r.item_id, uiText("inbox_err_missing", null, "Item no longer exists."));
                    } else if (r.entry_id) {
                        okCount += 1;
                        markItemPromoted(r.item_id, r.entry_id);
                    }
                });
                if (okCount > 0) {
                    showToast(uiText("inbox_promoted_toast", null, "Added to dictionary"));
                }
                syncInboxCounters();
            })
            .catch((err) => {
                console.error(err);
                itemIds.forEach((id) => showItemError(id, uiText("inbox_err_promote", null, "Failed to promote item.")));
                if (triggerBtn) triggerBtn.disabled = false;
            });
    }

    function applyItemUpdateToDom(li, word, context, defText) {
        li.dataset.word = word;
        li.dataset.context = context;
        li.dataset.definition = defText;
        const wordEl = li.querySelector(".inbox-item-word");
        if (wordEl) wordEl.textContent = word;
        const audioBtn = li.querySelector(".inbox-audio-btn");
        if (audioBtn) audioBtn.dataset.word = word;
        const ctxEl = li.querySelector(".inbox-item-context");
        if (ctxEl) {
            ctxEl.textContent = context;
            ctxEl.hidden = !context.trim();
        }
        const defEl = li.querySelector(".inbox-item-def");
        if (defEl) {
            defEl.textContent = defText;
            defEl.hidden = !defText.trim();
        }
        const form = li.querySelector(".inbox-edit-form");
        if (form) {
            const defTa = form.querySelector('textarea[name="definition_text"]');
            if (defTa) defTa.value = defText;
        }
    }

    document.querySelectorAll(".inbox-collapse-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
            const bodyId = btn.getAttribute("aria-controls");
            const body = bodyId ? document.getElementById(bodyId) : null;
            if (!body) return;
            const expanded = btn.getAttribute("aria-expanded") === "true";
            btn.setAttribute("aria-expanded", String(!expanded));
            body.hidden = expanded;
            btn.textContent = expanded
                ? uiText("inbox_expand", null, "Expand")
                : uiText("inbox_collapse", null, "Collapse");
        });
    });

    document.querySelectorAll(".inbox-audio-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
            playWordPronunciation(btn.dataset.word || "", btn);
        });
    });

    document.querySelectorAll(".inbox-promote-one").forEach((btn) => {
        btn.addEventListener("click", () => promoteIds([Number(btn.dataset.itemId)], btn));
    });

    document.querySelectorAll(".inbox-promote-all").forEach((btn) => {
        btn.addEventListener("click", () => {
            const ids = (btn.dataset.itemIds || "").split(",").map(Number).filter(Boolean);
            if (ids.length) promoteIds(ids, btn);
        });
    });

    document.querySelectorAll(".inbox-lookup-toggle").forEach((btn) => {
        btn.addEventListener("click", () => {
            const li = btn.closest(".inbox-item");
            if (!li) return;
            const panel = li.querySelector(".inbox-lookup-panel");
            if (!panel) return;
            if (!panel.hidden) {
                panel.hidden = true;
                return;
            }
            panel.hidden = false;
            panel.textContent = uiText("inbox_looking_up", null, "Looking up…");
            const word = li.dataset.word || "";
            const itemId = li.dataset.itemId;
            fetchJson("/api/v1/lookup?word=" + encodeURIComponent(word))
                .then((data) => {
                    panel.textContent = "";
                    const senses = Array.isArray(data.senses) ? data.senses.slice(0, 4) : [];
                    if (!senses.length) {
                        const empty = document.createElement("p");
                        empty.className = "quiz-empty";
                        empty.textContent = uiText("inbox_no_senses", null, "No thesaurus senses found.");
                        panel.appendChild(empty);
                        return;
                    }
                    senses.forEach((sense) => {
                        const row = document.createElement("div");
                        row.className = "inbox-lookup-sense";
                        const text = document.createElement("span");
                        const pos = sense.part_of_speech ? "(" + sense.part_of_speech + ") " : "";
                        text.textContent = pos + (sense.meaning || "");
                        row.appendChild(text);
                        if (sense.meaning && !li.classList.contains("is-promoted")) {
                            const useBtn = document.createElement("button");
                            useBtn.type = "button";
                            useBtn.className = "button button-ghost";
                            useBtn.style.marginLeft = "8px";
                            useBtn.textContent = uiText("inbox_use_sense", null, "+ Use");
                            useBtn.addEventListener("click", () => {
                                useBtn.disabled = true;
                                const formatted = pos + sense.meaning;
                                const prevDef = (li.dataset.definition || "").trim();
                                const nextDef = prevDef ? prevDef + "\n" + formatted : formatted;
                                fetchJson("/api/v1/page-note/items/" + encodeURIComponent(itemId), {
                                    method: "PATCH",
                                    headers: Object.assign({ "Content-Type": "application/json" }, csrfHeaders()),
                                    body: JSON.stringify({
                                        word: li.dataset.word || "",
                                        context: li.dataset.context || "",
                                        definition_text: nextDef,
                                    }),
                                })
                                    .then(() => {
                                        applyItemUpdateToDom(li, li.dataset.word || "", li.dataset.context || "", nextDef);
                                        showToast(uiText("inbox_updated_toast", null, "Item updated"));
                                    })
                                    .catch(() => {
                                        showItemError(itemId, uiText("inbox_err_update", null, "Failed to update item."));
                                    })
                                    .finally(() => {
                                        useBtn.disabled = false;
                                    });
                            });
                            row.appendChild(useBtn);
                        }
                        panel.appendChild(row);
                    });
                })
                .catch(() => {
                    panel.textContent = uiText("synonyms_error", null, "Thesaurus lookup temporarily unavailable.");
                });
        });
    });

    document.querySelectorAll(".inbox-edit-toggle").forEach((btn) => {
        btn.addEventListener("click", () => {
            const li = btn.closest(".inbox-item");
            if (!li) return;
            const form = li.querySelector(".inbox-edit-form");
            if (!form) return;
            form.hidden = !form.hidden;
            if (!form.hidden) {
                const wordInput = form.querySelector('input[name="word"]');
                if (wordInput) wordInput.focus();
            }
        });
    });

    document.querySelectorAll(".inbox-edit-cancel").forEach((btn) => {
        btn.addEventListener("click", () => {
            const form = btn.closest(".inbox-edit-form");
            if (form) form.hidden = true;
        });
    });

    document.querySelectorAll(".inbox-edit-form").forEach((form) => {
        form.addEventListener("submit", (event) => {
            event.preventDefault();
            const li = form.closest(".inbox-item");
            if (!li) return;
            const itemId = li.dataset.itemId;
            const word = form.querySelector('input[name="word"]').value.trim();
            const context = form.querySelector('textarea[name="context"]').value;
            const definitionText = form.querySelector('textarea[name="definition_text"]').value;
            if (!word) {
                showItemError(itemId, uiText("inbox_err_word_empty", null, "Word cannot be empty."));
                return;
            }
            const submitBtn = form.querySelector('button[type="submit"]');
            if (submitBtn) submitBtn.disabled = true;
            showItemError(itemId, "");
            fetchJson("/api/v1/page-note/items/" + encodeURIComponent(itemId), {
                method: "PATCH",
                headers: Object.assign({ "Content-Type": "application/json" }, csrfHeaders()),
                body: JSON.stringify({
                    word: word,
                    context: context,
                    definition_text: definitionText,
                }),
            })
                .then(() => {
                    applyItemUpdateToDom(li, word, context, definitionText);
                    form.hidden = true;
                    if (submitBtn) submitBtn.disabled = false;
                    showToast(uiText("inbox_updated_toast", null, "Item updated"));
                })
                .catch((err) => {
                    console.error(err);
                    showItemError(itemId, uiText("inbox_err_update", null, "Failed to update item."));
                    if (submitBtn) submitBtn.disabled = false;
                });
        });
    });

    document.querySelectorAll(".inbox-delete-one").forEach((btn) => {
        btn.addEventListener("click", () => {
            confirmDialog(
                uiText("inbox_confirm_delete_item", null, "Remove this captured item?"),
                { danger: true }
            ).then((ok) => {
                if (!ok) return;
                const li = btn.closest(".inbox-item");
                const card = btn.closest(".inbox-note-card");
                fetchJson("/api/v1/page-note/items/" + encodeURIComponent(btn.dataset.itemId), {
                    method: "DELETE",
                    headers: csrfHeaders(),
                })
                    .then((data) => {
                        if (data && data.note_deleted && card) {
                            card.remove();
                        } else if (li) {
                            li.remove();
                        }
                        syncInboxCounters();
                        showToast(uiText("inbox_deleted_toast", null, "Removed"));
                    })
                    .catch((err) => console.error(err));
            });
        });
    });

    document.querySelectorAll(".inbox-delete-note").forEach((btn) => {
        btn.addEventListener("click", () => {
            confirmDialog(
                uiText("inbox_confirm_delete_note", null, "Delete this page note and all of its captured items?"),
                { danger: true }
            ).then((ok) => {
                if (!ok) return;
                const card = btn.closest(".inbox-note-card");
                fetch("/api/v1/page-note/" + encodeURIComponent(btn.dataset.noteId), {
                    method: "DELETE",
                    headers: Object.assign({ Accept: "application/json" }, csrfHeaders()),
                })
                    .then(handleProtectedResponse)
                    .then((resp) => {
                        if (resp.ok && card) {
                            card.remove();
                            syncInboxCounters();
                            showToast(uiText("inbox_deleted_toast", null, "Removed"));
                        }
                    })
                    .catch((err) => console.error(err));
            });
        });
    });

    if (clearPromotedBtn) {
        clearPromotedBtn.addEventListener("click", () => {
            confirmDialog(
                uiText("inbox_confirm_clear_promoted", null, "Remove all already-added items from the inbox?"),
                { danger: true }
            ).then((ok) => {
                if (!ok) return;
                clearPromotedBtn.disabled = true;
                fetchJson("/api/v1/page-note/clear-promoted", {
                    method: "POST",
                    headers: Object.assign({ "Content-Type": "application/json" }, csrfHeaders()),
                    body: JSON.stringify({}),
                })
                    .then(() => {
                        document.querySelectorAll(".inbox-item.is-promoted").forEach((li) => li.remove());
                        document.querySelectorAll(".inbox-note-card").forEach((card) => {
                            const hasItems = card.querySelector(".inbox-item") !== null;
                            const ta = card.querySelector(".inbox-scratchpad-input");
                            const hasNotes = ta && ta.value.trim().length > 0;
                            if (!hasItems && !hasNotes) card.remove();
                        });
                        syncInboxCounters();
                        showToast(uiText("inbox_cleared_toast", null, "Cleared promoted items"));
                    })
                    .catch((err) => {
                        console.error(err);
                        clearPromotedBtn.disabled = false;
                    });
            });
        });
    }

    document.querySelectorAll(".inbox-save-notes").forEach((btn) => {
        btn.addEventListener("click", () => {
            const card = btn.closest(".inbox-note-card");
            if (!card) return;
            const textarea = card.querySelector(".inbox-scratchpad-input");
            const statusEl = card.querySelector(".inbox-scratchpad-status");
            if (!textarea) return;
            btn.disabled = true;
            if (statusEl) statusEl.textContent = uiText("inbox_saving", null, "Saving\u2026");
            fetchJson("/api/v1/page-note", {
                method: "PUT",
                headers: Object.assign({ "Content-Type": "application/json" }, csrfHeaders()),
                body: JSON.stringify({
                    url: card.dataset.noteUrl,
                    title: card.dataset.noteTitle || "",
                    notes_md: textarea.value,
                }),
            })
                .then((data) => {
                    if (data && data.id === null) {
                        card.remove();
                        syncInboxCounters();
                        return;
                    }
                    if (statusEl) statusEl.textContent = uiText("inbox_saved", null, "Saved");
                    btn.disabled = false;
                })
                .catch((err) => {
                    console.error(err);
                    if (statusEl) statusEl.textContent = uiText("inbox_save_failed", null, "Save failed");
                    btn.disabled = false;
                });
        });
    });
});
</script>
{% endblock body %}
