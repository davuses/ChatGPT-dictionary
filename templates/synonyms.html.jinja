{% extends "base.html.jinja" %}
{% from "_page_header.html.jinja" import page_header with context %}
{% block title %}{{ t('syn.title', word=word) }}{% endblock title %}

{% block body %}
{% set entry_link %}<a class="button button-ghost" href="/entry/{{ entry_id }}">{{ t('nav.entry') }}</a>{% endset %}
{{ page_header(extra_nav=entry_link) }}

<h1 class="word-title">{{ t('syn.heading') }} <a href="/entry/{{ entry_id }}">{{ word }}</a></h1>

{% if senses %}
<table class="synonyms-table data-table">
    <thead>
        <tr>
            <th>{{ t('syn.col_pos') }}</th>
            <th>{{ t('syn.col_meaning') }}</th>
            <th>{{ t('syn.col_synonyms') }}</th>
        </tr>
    </thead>
    <tbody>
        {% for sense in senses %}
        <tr>
            <td>{{ sense.part_of_speech }}</td>
            <td>{{ sense.meaning }}</td>
            <td>
                {% for syn in sense.synonyms %}
                {% set syn_key = syn.lower() %}
                {% if syn_key in all_words %}
                {% for eid in all_words[syn_key] %}
                <a href="{{ url_for('entry_page', entry_id=eid) }}">{{ syn }}</a>{% if not loop.last %} / {% endif
                %}{% endfor %}{% else %}{{ syn }}{% endif %}{% if not loop.last %},{% endif %}
                {% endfor %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<p class="content-section">{{ t('syn.empty') }}</p>
{% endif %}


{% endblock body %}
