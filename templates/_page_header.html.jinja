{#
  Shared global header, used by every page so nav items/order/labels can't
  drift per-template. `active` highlights the current section (browse/notes/
  add, or omitted on pages that aren't one of those - an entry page, a
  form, an error page). `brand_as_h1` is true only on the dashboard, where
  "My Dictionary" is the actual subject of the page; everywhere else the
  page's own content is the real <h1> and the brand is a styled
  (non-heading) link back home - font-weight is pinned explicitly in CSS
  so that choice of tag can't visibly change how bold it renders.
  `show_notes` is true only on the dashboard: Notes is a secondary section,
  not something every page needs a shortcut to. Quiz isn't in this nav at
  all - the dashboard already features it as an on-page card, and it isn't
  a frequent-enough destination from everywhere else to earn a global slot.
  `show_add` is true only on the dashboard and Browse: Add is a starting
  point reachable from those two hubs, not something every entry/edit/note
  page needs a shortcut to.
#}
{% macro page_header(subtitle=None, active=None, brand_as_h1=False, id=None, extra_nav="", show_notes=False, subtitle_id=None, show_add=False) %}
<header class="page-header"{% if id %} id="{{ id }}"{% endif %}>
    <div>
        {% if brand_as_h1 %}
        <h1><a href="/">My Dictionary</a></h1>
        {% else %}
        <p class="brand-title"><a href="/">My Dictionary</a></p>
        {% endif %}
        {% if subtitle %}<p class="page-subtitle"{% if subtitle_id %} id="{{ subtitle_id }}"{% endif %}>{{ subtitle }}</p>{% endif %}
    </div>
    <nav class="page-nav" aria-label="Main navigation">
        <a class="button button-ghost{% if active == 'browse' %} active{% endif %}" href="/entries">Browse</a>
        {% if show_notes %}<a class="button button-ghost{% if active == 'notes' %} active{% endif %}" href="/notes/">Notes</a>{% endif %}
        {% if show_add %}<a class="button button-ghost{% if active == 'add' %} active{% endif %}" href="/add_entry">Add</a>{% endif %}
        {{ extra_nav | safe }}
    </nav>
</header>
{% endmacro %}
