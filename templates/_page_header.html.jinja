{#
  Editorial page masthead used inside .app-main (authenticated app shell)
  and compact top bar on standalone pages (login, register, reset, error).
#}
{% macro page_header(subtitle=None, active=None, brand_as_h1=False, id=None, extra_nav="", subtitle_id=None, show_add=False, title=None, standalone=False, back_href=None, back_label=None) %}
{% if standalone or not is_authenticated %}
<header class="standalone-header"{% if id %} id="{{ id }}"{% endif %}>
    <a class="rail-brand" href="/">
        <span class="rail-brand-mark" aria-hidden="true"></span>
        <span class="rail-brand-name">Glossbook</span>
    </a>
    <div class="standalone-header-actions">
        <div class="theme-segmented" role="radiogroup" aria-label="{{ t('nav.theme_aria') }}">
            <button type="button" class="theme-seg-btn" role="radio" aria-checked="true" data-theme-value="auto">{{ t('nav.theme_auto_short') }}</button>
            <button type="button" class="theme-seg-btn" role="radio" aria-checked="false" data-theme-value="light">{{ t('nav.theme_light_short') }}</button>
            <button type="button" class="theme-seg-btn" role="radio" aria-checked="false" data-theme-value="dark">{{ t('nav.theme_dark_short') }}</button>
        </div>
        <form class="inline-form" method="post" action="/language">
            <input type="hidden" name="lang" value="{{ other_lang }}">
            <input type="hidden" name="next_path" value="{{ current_next_path }}">
            <button class="button button-ghost" type="submit" aria-label="{{ t('nav.switch_lang_aria') }}">{{ t('nav.switch_lang_label') }}</button>
        </form>
    </div>
</header>
{% else %}
<header class="page-masthead"{% if id %} id="{{ id }}"{% endif %}>
    <div class="masthead-left">
        <button type="button" class="rail-icon-btn rail-expand-btn" id="rail-expand-btn" aria-label="{{ t('nav.rail_expand') }}" title="{{ t('nav.rail_expand') }} ([)">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><use href="#icon-rail"/></svg>
        </button>
        <div class="masthead-heading">
            {% if back_href and back_label %}
            <a class="masthead-back-link" href="{{ back_href }}">&larr; {{ back_label }}</a>
            {% endif %}
            {% if brand_as_h1 %}
            <h1 class="masthead-title">{{ title or t('nav.today') }}</h1>
            {% elif title %}
            <h1 class="masthead-title">{{ title }}</h1>
            {% endif %}
            {% if subtitle %}
            <p class="page-subtitle"{% if subtitle_id %} id="{{ subtitle_id }}"{% endif %}>{{ subtitle }}</p>
            {% endif %}
        </div>
    </div>
    <div class="masthead-actions">
        {{ extra_nav | safe }}
        <button type="button" class="button button-ghost masthead-mobile-search" data-open-quick-search aria-label="{{ t('nav.search_aria') }}">
            <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><use href="#icon-search"/></svg>
        </button>
        {% if show_add %}
        <a class="button button-primary masthead-mobile-add" href="/add_entry">{{ t('nav.add') }}</a>
        {% endif %}
    </div>
</header>
{% endif %}
{% endmacro %}
