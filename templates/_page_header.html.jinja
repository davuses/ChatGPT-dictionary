{#
  Shared global header, used by every page so nav items, order, and labels
  stay consistent across the entire app.
  - Primary navigation (`Browse`, `Inbox`, and admin-only `Notes`) is rendered
    as borderless links on every authenticated page.
  - Contextual page actions (`extra_nav` and hub-page `+ Add`) sit between
    primary navigation and the user account menu.
  - The right-aligned user menu (`<details class="nav-account-menu">`) keeps
    `Account`, admin-only `Admin`, and `Log out` consistently reachable from
    every authenticated page without cramming 7 boxed buttons onto 2 rows.
#}
{% macro page_header(subtitle=None, active=None, brand_as_h1=False, id=None, extra_nav="", subtitle_id=None, show_add=False) %}
<header class="page-header"{% if id %} id="{{ id }}"{% endif %}>
  <div class="page-header-inner">
    <div class="page-header-brand">
        {% if brand_as_h1 %}
        <h1><a href="/">Glossbook</a></h1>
        {% else %}
        <p class="brand-title"><a href="/">Glossbook</a></p>
        {% endif %}
        {% if subtitle %}<p class="page-subtitle"{% if subtitle_id %} id="{{ subtitle_id }}"{% endif %}>{{ subtitle }}</p>{% endif %}
    </div>
    {% if is_authenticated %}
    <nav class="page-nav" aria-label="{{ t('nav.main_aria') }}">
        <a class="nav-link{% if active == 'review' %} active{% endif %}" href="/review"{% if active == 'review' %} aria-current="page"{% endif %}>{{ t('nav.review') }}</a>
        <a class="nav-link{% if active == 'browse' %} active{% endif %}" href="/entries"{% if active == 'browse' %} aria-current="page"{% endif %}>{{ t('nav.words') }}</a>
        <a class="nav-link{% if active == 'inbox' %} active{% endif %}" href="/inbox"{% if active == 'inbox' %} aria-current="page"{% endif %}>{{ t('nav.inbox') }}{% if inbox_pending_count %}<span class="nav-badge" id="nav-inbox-badge">{{ inbox_pending_count }}</span>{% endif %}</a>
        {% if is_admin %}
        <a class="nav-link{% if active == 'notes' %} active{% endif %}" href="/notes/"{% if active == 'notes' %} aria-current="page"{% endif %}>{{ t('nav.notes') }}</a>
        {% endif %}
        {{ extra_nav | safe }}
        {% if show_add %}<a class="button button-primary nav-add-btn{% if active == 'add' %} active{% endif %}" href="/add_entry">{{ t('nav.add') }}</a>{% endif %}
        <details class="nav-account-menu">
            <summary class="button button-ghost nav-account-trigger{% if active in ('account', 'admin') %} active{% endif %}" aria-label="{{ t('nav.account_menu_aria') }}">
                <span class="nav-account-name">{{ current_user.username if current_user else t('nav.account') }}</span>
                <svg class="nav-caret" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
                    <path d="M2.5 4.25L6 7.75l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </summary>
            <div class="nav-account-dropdown">
                <a class="nav-menu-item{% if active == 'account' %} active{% endif %}" href="/account"{% if active == 'account' %} aria-current="page"{% endif %}>{{ t('nav.account') }}</a>
                {% if is_admin %}
                <a class="nav-menu-item{% if active == 'admin' %} active{% endif %}" href="/admin"{% if active == 'admin' %} aria-current="page"{% endif %}>{{ t('nav.admin') }}</a>
                {% endif %}
                <button class="nav-menu-item theme-toggle-btn" type="button" aria-label="{{ t('nav.theme_aria') }}">{{ t('nav.theme_auto') }}</button>
                <form class="nav-menu-form" method="post" action="/language">
                    <input type="hidden" name="lang" value="{{ other_lang }}">
                    <input type="hidden" name="next_path" value="{{ current_next_path }}">
                    <button class="nav-menu-item" type="submit" aria-label="{{ t('nav.switch_lang_aria') }}">{{ t('nav.switch_lang_label') }}</button>
                </form>
                <hr class="nav-menu-divider">
                <form class="nav-menu-form" method="post" action="/logout">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button class="nav-menu-item nav-menu-danger" type="submit">{{ t('nav.logout') }}</button>
                </form>
            </div>
        </details>
    </nav>
    {% else %}
    <nav class="page-nav" aria-label="{{ t('nav.main_aria') }}">
        <button class="button button-ghost theme-toggle-btn" type="button" aria-label="{{ t('nav.theme_aria') }}">{{ t('nav.theme_auto') }}</button>
        <form class="inline-form" method="post" action="/language">
            <input type="hidden" name="lang" value="{{ other_lang }}">
            <input type="hidden" name="next_path" value="{{ current_next_path }}">
            <button class="button button-ghost" type="submit" aria-label="{{ t('nav.switch_lang_aria') }}">{{ t('nav.switch_lang_label') }}</button>
        </form>
    </nav>
    {% endif %}
  </div>
</header>
{% endmacro %}
