{% extends "base.html.jinja" %}
{% block title %} Add Entry {% endblock title %}

{% block body %}
<nav class="page-toolbar" aria-label="Form navigation">
    <div class="page-toolbar-actions">
        <a class="button button-ghost" href="/">Dictionary</a>
    </div>
</nav>
<main class="form-page">
<h1>Add Entry</h1>
<form method="post"
    action="/add_entry">
    <textarea name="entry_text"></textarea><br>
    <div class="form-actions">
        <input type="submit"
            value="Submit">
    </div>
</form>
</main>
{% endblock body %}
