{% extends "base.html.jinja" %}
{% from "_page_header.html.jinja" import page_header with context %}
{% block title %}{{ t('admin.title') }}{% endblock title %}
{% block body_class %}page-narrow{% endblock body_class %}
{% block nav_active %}admin{% endblock nav_active %}

{% block body %}
{{ page_header(title=t('admin.title'), subtitle=t('admin.subtitle'), active="admin") }}

<main class="admin-page">
    {% if admin_error %}
    <p class="form-error" role="alert">{{ admin_error }}</p>
    {% endif %}

    {% if created_invite_url %}
    <section class="secret-box" role="status">
        <p><strong>{{ t('admin.invite_created') }}{% if created_invite_note %}{{ t('admin.invite_for', note=created_invite_note) }}{% endif %}</strong> {{ t('admin.invite_valid_hint') }}</p>
        <div class="secret-box-row">
            <input type="text" class="secret-input" id="created-invite-url" value="{{ created_invite_url }}" readonly>
            <button type="button" class="button button-primary copy-secret-btn" data-copy-target="created-invite-url">{{ t('account.copy') }}</button>
        </div>
    </section>
    {% endif %}

    {% if created_reset_url %}
    <section class="secret-box" role="status">
        <p><strong>{{ t('admin.reset_created', username=created_reset_username) }}</strong> {{ t('admin.reset_valid_hint') }}</p>
        <div class="secret-box-row">
            <input type="text" class="secret-input" id="created-reset-url" value="{{ created_reset_url }}" readonly>
            <button type="button" class="button button-primary copy-secret-btn" data-copy-target="created-reset-url">{{ t('account.copy') }}</button>
        </div>
    </section>
    {% endif %}

    <section class="editorial-section">
        <h2>{{ t('admin.invites_title') }}</h2>
        <p class="section-desc">{{ t('admin.invites_desc') }}</p>

        <form class="inline-create-form" method="post" action="/admin/invites">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="text" name="note" placeholder="{{ t('admin.invite_note_placeholder') }}" maxlength="100">
            <button class="button button-primary" type="submit">{{ t('admin.create_invite') }}</button>
        </form>

        {% if invites %}
        <div class="table-scroll">
        <table class="data-table admin-table">
            <thead>
                <tr>
                    <th>{{ t('admin.col_note') }}</th>
                    <th>{{ t('admin.col_status') }}</th>
                    <th>{{ t('admin.col_created') }}</th>
                    <th>{{ t('admin.col_action') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for inv in invites %}
                <tr>
                    <td>{{ inv.note or "—" }}</td>
                    <td>
                        {% if inv.used_at %}
                        <span class="status-pill status-used">{{ t('admin.status_used') }}{% if inv.used_by_username %}{{ t('admin.status_used_by', username=inv.used_by_username) }}{% endif %}</span>
                        {% elif inv.expires_at <= now_ts %}
                        <span class="status-pill status-expired">{{ t('admin.status_expired') }}</span>
                        {% else %}
                        <span class="status-pill status-active">{{ t('admin.status_pending') }}</span>
                        {% endif %}
                    </td>
                    <td class="num-cell">{{ how_long_ago(inv.created_at) }}</td>
                    <td>
                        {% if not inv.used_at %}
                        <form class="inline-form" method="post" action="/admin/invites/{{ inv.id }}/revoke" data-confirm-key="confirm_revoke_invite" data-confirm-danger="true">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                            <button class="button button-danger" type="submit">{{ t('account.revoke') }}</button>
                        </form>
                        {% else %}
                        —
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
        {% else %}
        <p class="section-desc">{{ t('admin.no_invites') }}</p>
        {% endif %}
    </section>

    <section class="editorial-section">
        <h2>{{ t('admin.users_title', n=users | length) }}</h2>
        <div class="table-scroll">
        <table class="data-table admin-table">
            <thead>
                <tr>
                    <th>{{ t('admin.col_username') }}</th>
                    <th>{{ t('admin.col_role') }}</th>
                    <th>{{ t('admin.col_entries') }}</th>
                    <th>{{ t('admin.col_status') }}</th>
                    <th>{{ t('admin.col_actions') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for u in users %}
                <tr>
                    <td><strong>{{ u.username }}</strong>{% if u.id == current_user.id %}{{ t('admin.you_tag') }}{% endif %}</td>
                    <td>{{ t('admin.role_admin' if u.is_admin else 'admin.role_member') }}</td>
                    <td class="num-cell">{{ u.entry_count }}</td>
                    <td>
                        {% if u.is_active %}
                        <span class="status-pill status-active">{{ t('admin.status_active') }}</span>
                        {% else %}
                        <span class="status-pill status-expired">{{ t('admin.status_disabled') }}</span>
                        {% endif %}
                    </td>
                    <td>
                        <div class="admin-user-actions">
                            {% if u.is_active %}
                            <form class="inline-form" method="post" action="/admin/users/{{ u.id }}/reset-link">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                <button class="button button-ghost" type="submit">{{ t('admin.reset_link') }}</button>
                            </form>
                            {% endif %}
                            {% if u.id != current_user.id %}
                            <form class="inline-form" method="post" action="/admin/users/{{ u.id }}/toggle-active"{% if u.is_active %} data-confirm-key="confirm_disable_user" data-confirm-danger="true"{% endif %}>
                                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                <button class="button {% if u.is_active %}button-danger{% else %}button-ghost{% endif %}" type="submit">
                                    {{ t('admin.disable' if u.is_active else 'admin.enable') }}
                                </button>
                            </form>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
    </section>
</main>

<script>
document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".copy-secret-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
            const input = document.getElementById(btn.dataset.copyTarget);
            if (!input) return;
            input.select();
            navigator.clipboard?.writeText(input.value).then(() => {
                btn.textContent = uiText("copied", null, "Copied");
                setTimeout(() => { btn.textContent = uiText("copy", null, "Copy"); }, 1800);
            }).catch(() => {});
        });
    });
});
</script>
{% endblock body %}
