{#
  The table + pagination for /entries. Extracted so it can be rendered
  standalone as the live-search JSON response's results_html (see
  entries_page() in main.py) as well as included normally inside
  entries.html.jinja for a full page load. Self-contained (defines its own
  view_qs) since a standalone render has no access to macros defined in the
  including template.
#}
{% macro view_qs(extra) %}{% if search_query %}{{ extra }}q={{ search_query | urlencode }}{% endif %}{% endmacro %}

{% if not entry_displays %}
<p class="entries-empty">
    {% if search_query %}No matching entries for &ldquo;{{ search_query }}&rdquo;.{% elif needs_definition %}All entries have definitions.{% else %}No entries yet.{% endif %}
</p>
{% else %}
{% set table_variant = "only" if entries_only else ("examples" if show_example else "default") %}
<table class="entries-table entries-table--{{ table_variant }}">
    {% if entries_only %}
    <caption class="sr-only">Entries Only</caption>
    {% include "entries_only_table.html.jinja" %}
    {% elif show_example %}
    <caption class="sr-only">Entries with Examples</caption>
    {% include "entries_with_examples.html.jinja" %}
    {% elif needs_definition %}
    <caption class="sr-only">Entries Needing Definitions</caption>
    {% include "entries_default.html.jinja" %}
    {% else %}
    <caption class="sr-only">My Entries</caption>
    {% include "entries_default.html.jinja" %}
    {% endif %}

</table>
{% endif %}

{% if total_pages > 1 %}
<nav class="pagination" aria-label="Pagination">
    {% set base_qs = view_qs('&') %}
    {% set mode_prefix = "entries_only=true&" if entries_only else ("show_example=true&" if show_example else ("needs_definition=true&" if needs_definition else "")) %}
    {% if has_prev_page %}
    <a class="button button-ghost" href="/entries?{{ mode_prefix }}page=1{{ base_qs }}">&laquo; First</a>
    <a class="button button-ghost" href="/entries?{{ mode_prefix }}page={{ page - 1 }}{{ base_qs }}">&larr; Prev</a>
    {% else %}
    <span class="button button-ghost" aria-disabled="true">&laquo; First</span>
    <span class="button button-ghost" aria-disabled="true">&larr; Prev</span>
    {% endif %}
    <span class="pagination-status">Page {{ page }} of {{ total_pages }}</span>
    {% if has_next_page %}
    <a class="button button-ghost" href="/entries?{{ mode_prefix }}page={{ page + 1 }}{{ base_qs }}">Next &rarr;</a>
    <a class="button button-ghost" href="/entries?{{ mode_prefix }}page={{ total_pages }}{{ base_qs }}">Last &raquo;</a>
    {% else %}
    <span class="button button-ghost" aria-disabled="true">Next &rarr;</span>
    <span class="button button-ghost" aria-disabled="true">Last &raquo;</span>
    {% endif %}
</nav>
{% endif %}
