{#
  The table + pagination for /entries. Extracted so it can be rendered
  standalone as the live-search JSON response's results_html (see
  entries_page() in main.py) as well as included normally inside
  entries.html.jinja for a full page load. Self-contained (defines its own
  view_qs) since a standalone render has no access to macros defined in the
  including template.
#}
{% macro view_qs(extra) -%}
{%- set parts = [] -%}
{%- if search_query %}{% set _ = parts.append('q=' ~ (search_query | urlencode)) %}{% endif -%}
{%- if sort and sort != 'newest' %}{% set _ = parts.append('sort=' ~ (sort | urlencode)) %}{% endif -%}
{%- if parts %}{{ extra }}{{ parts | join('&') }}{% endif -%}
{%- endmacro %}

{% if not entry_displays %}
<p class="entries-empty">
    {% if search_query %}{{ t('entries.empty_search', q=search_query) }}{% elif needs_definition %}{{ t('entries.empty_needs_def') }}{% else %}{{ t('entries.empty_all') }}{% endif %}
</p>
{% else %}
{% set table_variant = "only" if entries_only else ("definitions" if show_definition else ("examples" if show_example else "default")) %}
<table class="entries-table entries-table--{{ table_variant }}">
    {% if entries_only %}
    <caption class="sr-only">{{ t('entries.caption_only') }}</caption>
    {% include "entries_only_table.html.jinja" %}
    {% elif show_definition %}
    <caption class="sr-only">{{ t('entries.caption_definitions') }}</caption>
    {% include "entries_with_definitions.html.jinja" %}
    {% elif show_example %}
    <caption class="sr-only">{{ t('entries.caption_examples') }}</caption>
    {% include "entries_with_examples.html.jinja" %}
    {% elif needs_definition %}
    <caption class="sr-only">{{ t('entries.caption_needs_def') }}</caption>
    {% include "entries_default.html.jinja" %}
    {% else %}
    <caption class="sr-only">{{ t('entries.caption_all') }}</caption>
    {% include "entries_default.html.jinja" %}
    {% endif %}

</table>
{% endif %}

{% if total_pages > 1 %}
<nav class="pagination" aria-label="Pagination">
    {% set base_qs = view_qs('&') %}
    {% set mode_prefix = "entries_only=true&" if entries_only else ("show_definition=true&" if show_definition else ("show_example=true&" if show_example else ("needs_definition=true&" if needs_definition else ""))) %}
    {% if has_prev_page %}
    <a class="button button-ghost" href="/entries?{{ mode_prefix }}page=1{{ base_qs }}">&laquo; {{ t('entries.page_first') }}</a>
    <a class="button button-ghost" href="/entries?{{ mode_prefix }}page={{ page - 1 }}{{ base_qs }}">&larr; {{ t('entries.page_prev') }}</a>
    {% else %}
    <span class="button button-ghost" aria-disabled="true">&laquo; {{ t('entries.page_first') }}</span>
    <span class="button button-ghost" aria-disabled="true">&larr; {{ t('entries.page_prev') }}</span>
    {% endif %}
    <span class="pagination-status">{{ t('entries.page_status', page=page, total=total_pages) }}</span>
    {% if has_next_page %}
    <a class="button button-ghost" href="/entries?{{ mode_prefix }}page={{ page + 1 }}{{ base_qs }}">{{ t('entries.page_next') }} &rarr;</a>
    <a class="button button-ghost" href="/entries?{{ mode_prefix }}page={{ total_pages }}{{ base_qs }}">{{ t('entries.page_last') }} &raquo;</a>
    {% else %}
    <span class="button button-ghost" aria-disabled="true">{{ t('entries.page_next') }} &rarr;</span>
    <span class="button button-ghost" aria-disabled="true">{{ t('entries.page_last') }} &raquo;</span>
    {% endif %}
</nav>
{% endif %}
