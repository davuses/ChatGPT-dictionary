{% extends "base.html.jinja" %}
{% from "_page_header.html.jinja" import page_header with context %}
{% block title %}{{ t('err.404_title') }}{% endblock title %}
{% block chrome_mode %}standalone{% endblock chrome_mode %}

{% block body %}
{{ page_header(standalone=True) }}
<main class="error-page">
    <p class="error-code">404</p>
    <h1>{{ t('err.404_heading') }}</h1>
    <p class="error-detail">{{ detail }}</p>
    <p><a class="button button-primary" href="/">{{ t('review.back_dashboard') }}</a></p>
</main>
{% endblock body %}
