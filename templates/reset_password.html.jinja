{% extends "base.html.jinja" %}
{% from "_page_header.html.jinja" import page_header with context %}
{% block title %}{{ t('auth.reset_title') }}{% endblock title %}
{% block body_class %}page-auth{% endblock body_class %}

{% block body %}
{{ page_header() }}
<main class="form-page auth-card card">
    <h1>{{ t('auth.reset_heading') }}</h1>
    {% if error %}<p class="form-error" role="alert">{{ error }}</p>{% endif %}
    {% if token_valid %}
    <p class="page-subtitle">{{ t('auth.reset_for_user') }} <strong>{{ target_username }}</strong>.</p>
    <form class="login-form" method="post" action="/reset-password">
        <input type="hidden" name="csrf_token" value="{{ form_csrf_token }}">
        <input type="hidden" name="token" value="{{ token }}">
        <label for="password">{{ t('auth.new_password') }}</label>
        <input id="password" name="password" type="password" autocomplete="new-password" minlength="10" maxlength="128" required autofocus>
        <label for="confirm_password">{{ t('auth.confirm_new_password') }}</label>
        <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" minlength="10" maxlength="128" required>
        <div class="form-actions">
            <button class="button button-primary" type="submit">{{ t('auth.save_password') }}</button>
        </div>
    </form>
    {% else %}
    <p><a class="button button-ghost" href="/login">{{ t('auth.back_to_login') }}</a></p>
    {% endif %}
</main>
{% endblock body %}
