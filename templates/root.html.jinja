{% extends "base.html.jinja" %}
{% from "_quiz_card.html.jinja" import quiz_card %}
{% block title %}My Dictionary{% endblock title %}

{% block body %}

<header class="home-header">
    <div>
        <h1><a href="/">My Dictionary</a></h1>
        <p class="page-subtitle">{{ entries_count }} entries &middot; {{ visited_last_7_days }} visited in the last 7 days</p>
    </div>
    <nav class="home-actions" aria-label="Main navigation">
        <a class="button button-ghost" href="/add_entry">Add</a>
        <a class="button button-ghost" href="/entries">Browse</a>
        <a class="button button-ghost" href="/notes/">Notes</a>
    </nav>
</header>

{% block dashboard_widgets %}
<section class="dashboard-card">
    <h2>Today's word</h2>
    {{ quiz_card(question, action_href="/quiz", action_label="Try another") }}
</section>
{% endblock dashboard_widgets %}

{% if review_bookmark_entry_id %}
<p class="dashboard-secondary-action">Pick up where you left off &mdash; <a href="/resume_review">Resume from last mark</a></p>
{% endif %}

{% endblock body %}
