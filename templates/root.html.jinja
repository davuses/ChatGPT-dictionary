{% extends "base.html.jinja" %}
{% block title %}
My Dictionary
{% endblock title %}
{% block body %}

<h1 id="top"><a href="/"
        style="text-decoration: none"
        ;> Latest Questions</a> {{ questions_count }} </h1>

<p style="display: flex; justify-content: space-between; align-items: center;">
    <span>
        <a class="header-link"
            href="/?questions_only=true"
            style="text-decoration: none;">Questions Only</a>
        <a class="header-link"
            href="/?example=true"
            style="text-decoration: none;">Show Examples</a>

        {# <a class="header-link"
            href="/add_question"
            style="text-decoration: none;">Add Question</a> #}
    </span>
    <a class="header-link"
        href="/notes/"
        style="font-weight: bold">My Notes</a>
</p>
<table border="1">
    {% if questions_only %}
    <caption>Questions Only</caption>
    {% include "questions_only_table.html.jinja" %}
    {% elif show_example %}
    <caption>Questions with Examples</caption>
    {% include "questions_with_examples.html.jinja" %}
    {% else %}
    <caption>My Questions</caption>
    {% include "questions_default.html.jinja" %}
    {% endif %}

</table>
<div id="bottom">
</div>
<a href="#"
    class="float">
    <i class="my-float"
        style="font-size:20px">top</i>
</a>
<script>
    document.addEventListener("keydown", (event) => {
        if (event.key === "a") {
            window.open("/add_question", "_blank").focus();
        }
        else if (event.key === "D") {
            delete_selected_question()
        }

    });
    document.addEventListener("DOMContentLoaded", function () {
        const rows = document.querySelectorAll("table tr");
        for (let i = 0; i < rows.length; i++) {
            rows[i].onclick = function () {
                highlightTableRow(this);
            };
        }
    });

    function highlightTableRow(row) {
        const previouslySelectedRow = document.querySelector("tr.selected");
        if (previouslySelectedRow) {
            previouslySelectedRow.classList.remove("selected");
        }
        row.classList.add("selected");
    }
    function delete_selected_question() {
        const selectedRow = document.querySelector("tr.selected")
        const selectedQId = selectedRow.id;
        const questionText = selectedRow.firstElementChild.textContent;
        if (
            confirm("Are you sure you want to delete this question?\n> " + questionText)
        ) {
            fetch("/delete_question/" + selectedQId).then((Response) => {
                if (Response.ok) {
                    selectedRow.parentNode.removeChild(selectedRow);
                }
            });
        }

    }
</script>

{% endblock body %}