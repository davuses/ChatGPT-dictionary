{% extends "base.html.jinja" %}
{% from "_quiz_card.html.jinja" import quiz_card %}
{% from "_page_header.html.jinja" import page_header %}
{% block title %}My Dictionary{% endblock title %}

{% block body %}

{{ page_header(subtitle=entries_count ~ " entries · " ~ visited_last_7_days ~ " visited in the last 7 days", brand_as_h1=True, show_notes=True) }}

{% block dashboard_widgets %}
<section class="card">
    <h2>Today's word</h2>
    {{ quiz_card(question, action_href="/quiz", action_label="Try another") }}
</section>
{% endblock dashboard_widgets %}

{% if review_bookmark_entry_id %}
<p class="dashboard-secondary-action">Pick up where you left off &mdash; <a href="/resume_review">Resume from last mark</a></p>
{% endif %}

{% endblock body %}
