{% extends "base.html.jinja" %}
{% from "_quiz_card.html.jinja" import quiz_card with context %}
{% from "_page_header.html.jinja" import page_header with context %}
{% block title %}Glossbook{% endblock title %}
{% block body_class %}page-narrow{% endblock body_class %}

{% block body %}

{% set dash_subtitle %}<a class="subtitle-link" href="/entries">{{ t('dash.entries_one' if entries_count == 1 else 'dash.entries_many', n=entries_count) }}</a> &middot; {{ t('dash.visited_7d', n=visited_last_7_days) }}{% endset %}
{{ page_header(subtitle=dash_subtitle, brand_as_h1=True, show_add=True) }}

<main class="page-content">
<form class="search-form dashboard-search" role="search" action="/entries" method="get">
    <input type="search"
        name="q"
        placeholder="{{ t('dash.search_placeholder') }}"
        aria-label="{{ t('dash.search_aria') }}">
    <button class="button button-primary" type="submit">{{ t('dash.search_btn') }}</button>
</form>

{% if pending_inbox_count > 0 or undefined_count > 0 %}
<div class="dashboard-stats">
    {% if pending_inbox_count > 0 %}
    <a class="stat-pill stat-pill--accent" href="/inbox">{{ t('dash.pill_inbox_one' if pending_inbox_count == 1 else 'dash.pill_inbox_many', n=pending_inbox_count) }}</a>
    {% endif %}
    {% if undefined_count > 0 %}
    <a class="stat-pill" href="/entries?needs_definition=true">{{ t('dash.pill_needs_def_one' if undefined_count == 1 else 'dash.pill_needs_def_many', n=undefined_count) }}</a>
    {% endif %}
</div>
{% endif %}

{% block dashboard_widgets %}
<section class="card">
    <div class="section-header">
        <h2>{{ t('dash.quiz_title') }}</h2>
        <a class="button button-ghost" href="/review">{{ t('dash.review_session') }}</a>
    </div>
    {{ quiz_card(question, action_exclude=next_exclude, action_label=t('quiz.try_another'), action_id="quiz-next-btn") }}
</section>
{% endblock dashboard_widgets %}

{% if not has_api_token %}
<section class="card extension-promo-card">
    <h2>{{ t('dash.ext_title') }}</h2>
    <p>{{ t('dash.ext_desc') }}</p>
    <div class="quiz-actions">
        <a class="button button-primary" href="{{ extension_download_url }}" target="_blank" rel="noopener noreferrer">{{ t('dash.ext_download') }}</a>
        <a class="button button-ghost" href="/account#extension">{{ t('dash.ext_setup') }}</a>
    </div>
</section>
{% endif %}

{% if review_bookmark_entry_id %}
<section class="card dashboard-resume-card">
    <p>{% if bookmark_word %}{{ t('dash.resume_word', word=bookmark_word) }}{% else %}{{ t('dash.resume_prefix') }}{% endif %}</p>
    <a class="button button-ghost" href="/resume_review">{{ t('dash.resume_link') }}</a>
</section>
{% endif %}
</main>

{% endblock body %}
