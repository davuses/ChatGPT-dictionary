{% extends "base.html.jinja" %}
{% block title %}
{% if entries_only %}
Entries Only
{% elif show_example %}
Show Example
{% elif review_mode %}
Review Mode
{% else %}
My Dictionary
{% endif %}
{% endblock title %}

{% block body %}

<h1 id="top"><a href="/"> Latest Entries</a> {{ entries_count }} </h1>

<p class="page-nav">
    <span>
        <a class="header-link" href="/?entries_only=true">Entries Only</a>
        <a class="header-link" href="/?show_example=true">Show Examples</a>
        <a class="header-link" href="/?review_mode=true">Review Mode</a>
    </span>
    <a class="header-link" href="/notes/" style="font-weight: bold">My Notes</a>
</p>
<table border="1">
    {% if entries_only %}
    <caption>Entries Only</caption>
    {% include "entries_only_table.html.jinja" %}
    {% elif show_example %}
    <caption>Entries with Examples</caption>
    {% include "entries_with_examples.html.jinja" %}
    {% elif review_mode %}
    <caption>Review Mode</caption>
    {% include "entries_review.html.jinja" %}
    {% else %}
    <caption>My Entries</caption>
    {% include "entries_default.html.jinja" %}
    {% endif %}

</table>
<div id="bottom">
</div>
<a href="#"
    class="float">
    <i class="my-float"
        style="font-size:20px">top</i>
</a>
<script>
    document.addEventListener("keydown", (event) => {
        if (event.key === "a") {
            window.open("/add_entry", "_blank").focus();
        }
        else if (event.key === "D") {
            delete_selected_entry()
        }

    });
    document.addEventListener("DOMContentLoaded", function () {
        const rows = document.querySelectorAll("table tr");

        rows.forEach(row => {
            row.addEventListener("click", function (event) {
                if (event.target.closest(".dynamic-delete-button")) return;

                const previouslySelectedRow = document.querySelector("tr.selected");
                if (previouslySelectedRow && previouslySelectedRow !== row) {
                    previouslySelectedRow.classList.remove("selected");
                }

                if (!previouslySelectedRow || previouslySelectedRow !== row) {
                    row.classList.add("selected");
                }
            });
        });
    });

    function delete_selected_entry() {
        const selectedRow = document.querySelector("tr.selected")
        const selectedEntryId = selectedRow.id;
        const entryText = selectedRow.firstElementChild.textContent;
        if (
            confirm("Are you sure you want to delete this entry?\n ID=" + selectedEntryId + entryText)
        ) {
            fetch("/delete_entry/" + selectedEntryId, { method: "DELETE" }).then((Response) => {
                if (Response.ok) {
                    selectedRow.parentNode.removeChild(selectedRow);
                }
            });
        }
    };
</script>

{% endblock body %}