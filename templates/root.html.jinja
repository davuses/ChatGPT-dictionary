{% extends "base.html.jinja" %}
{% from "_quiz_card.html.jinja" import quiz_card %}
{% block title %}
My Dictionary
{% endblock title %}

{% block body %}

<header class="home-header">
    <div>
        <h1><a href="/">My Dictionary</a></h1>
        <p class="entry-count">{{ entries_count }} entries</p>
    </div>
    <nav class="home-actions" aria-label="Main navigation">
        <a class="button button-primary" href="/add_entry">Add</a>
        <a class="button button-ghost" href="/entries">Browse</a>
        <a class="button button-ghost" href="/notes/">Notes</a>
    </nav>
</header>

<section class="dashboard-stats" aria-label="Stats">
    <div class="stat-card">
        <span class="stat-value">{{ entries_count }}</span>
        <span class="stat-label">total entries</span>
    </div>
    <div class="stat-card">
        <span class="stat-value">{{ visited_last_7_days }}</span>
        <span class="stat-label">visited in the last 7 days</span>
    </div>
</section>

{% if review_bookmark_entry_id %}
<section class="dashboard-card">
    <h2>Continue reviewing</h2>
    <p>Pick up where you left off.</p>
    <a class="button button-primary" href="/resume_review">Resume from last mark</a>
</section>
{% endif %}

{% block dashboard_widgets %}
<section class="dashboard-card">
    <h2>Today's word</h2>
    {{ quiz_card(question) }}
    <a class="button button-ghost" href="/quiz">Try another</a>
</section>
{% endblock dashboard_widgets %}

{% endblock body %}
