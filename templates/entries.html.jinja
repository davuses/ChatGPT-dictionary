{% extends "base.html.jinja" %}
{% from "_page_header.html.jinja" import page_header with context %}
{% block title -%}
{%- if entries_only -%}
{{ t('entries.title_only') }}
{%- elif show_definition -%}
{{ t('entries.title_definitions') }}
{%- elif show_example -%}
{{ t('entries.title_examples') }}
{%- elif needs_definition -%}
{{ t('entries.title_needs_def') }}
{%- else -%}
{{ t('nav.words') }}
{%- endif -%}
{%- endblock title %}
{% block nav_active %}browse{% endblock nav_active %}

{% block body %}

{% macro view_qs(extra) -%}
{%- set parts = [] -%}
{%- if search_query %}{% set _ = parts.append('q=' ~ (search_query | urlencode)) %}{% endif -%}
{%- if sort and sort != 'newest' %}{% set _ = parts.append('sort=' ~ (sort | urlencode)) %}{% endif -%}
{%- if parts %}{{ extra }}{{ parts | join('&') }}{% endif -%}
{%- endmacro %}

{% set can_split = (not entries_only) and (not show_definition) and (not show_example) %}
{% set page_heading = t('entries.title_only') if entries_only else (t('entries.title_definitions') if show_definition else (t('entries.title_examples') if show_example else (t('entries.title_needs_def') if needs_definition else t('nav.words')))) %}
{% set resume_link %}<a class="button button-ghost" id="resume-bookmark-link" href="/resume_review"{% if not review_bookmark_entry_id %} hidden{% endif %}>{{ t('dash.resume_link') }}</a>{% endset %}
{% set count_key = ('entries.count_matching_one' if entries_count == 1 else 'entries.count_matching') if search_query else ('entries.count_plain_one' if entries_count == 1 else 'entries.count_plain') %}
{{ page_header(title=page_heading, subtitle=t(count_key, n=entries_count), active="browse", id="top", extra_nav=resume_link, subtitle_id="results-count", show_add=True) }}

<main class="page-content">
<form class="search-form" id="entries-search-form" role="search" action="/entries" method="get">
    {% if entries_only %}<input type="hidden" name="entries_only" value="true">{% endif %}
    {% if show_definition %}<input type="hidden" name="show_definition" value="true">{% endif %}
    {% if show_example %}<input type="hidden" name="show_example" value="true">{% endif %}
    {% if needs_definition %}<input type="hidden" name="needs_definition" value="true">{% endif %}
    <input type="search"
        name="q"
        value="{{ search_query }}"
        placeholder="{{ t('entries.search_placeholder') }}"
        aria-label="{{ t('dash.search_aria') }}">
    <button class="button button-primary" type="submit">{{ t('dash.search_btn') }}</button>
    {% set clear_parts = [] %}
    {% if entries_only %}{% set _ = clear_parts.append('entries_only=true') %}
    {% elif show_definition %}{% set _ = clear_parts.append('show_definition=true') %}
    {% elif show_example %}{% set _ = clear_parts.append('show_example=true') %}
    {% elif needs_definition %}{% set _ = clear_parts.append('needs_definition=true') %}{% endif %}
    {% if sort and sort != 'newest' %}{% set _ = clear_parts.append('sort=' ~ (sort | urlencode)) %}{% endif %}
    <a class="button button-ghost" id="clear-search-link" href="/entries{% if clear_parts %}?{{ clear_parts | join('&') }}{% endif %}"{% if not search_query %} hidden{% endif %}>{{ t('entries.clear') }}</a>
</form>

<div class="entries-toolbar">
    <nav class="view-tabs" aria-label="{{ t('entries.views_aria') }}">
        <a class="view-tab {% if not entries_only and not show_definition and not show_example and not needs_definition %}active{% endif %}"
            id="tab-all"
            href="/entries{{ view_qs('?') }}">{{ t('entries.tab_all') }}</a>
        <a class="view-tab {% if entries_only %}active{% endif %}"
            id="tab-entries-only"
            href="/entries?entries_only=true{{ view_qs('&') }}">{{ t('entries.tab_only') }}</a>
        <a class="view-tab {% if show_example %}active{% endif %}"
            id="tab-examples"
            href="/entries?show_example=true{{ view_qs('&') }}">{{ t('entries.tab_examples') }}</a>
        <a class="view-tab {% if show_definition %}active{% endif %}"
            id="tab-definitions"
            href="/entries?show_definition=true{{ view_qs('&') }}">{{ t('entries.tab_definitions') }}</a>
        <a class="view-tab {% if needs_definition %}active{% endif %}"
            id="tab-needs-definition"
            href="/entries?needs_definition=true{{ view_qs('&') }}">{{ t('entries.tab_needs_def') }}{% if undefined_count > 0 %}<span id="undefined-count-badge" data-count="{{ undefined_count }}"{% if search_query %} hidden{% endif %}> ({{ undefined_count }})</span>{% endif %}</a>
    </nav>
    <div class="entries-toolbar-right">
        <label class="sort-control" for="entries-sort-select">
            <span>{{ t('entries.sort_label') }}</span>
            <select class="sort-select" id="entries-sort-select" name="sort" form="entries-search-form">
                <option value="newest"{% if sort == 'newest' %} selected{% endif %}>{{ t('entries.sort_newest') }}</option>
                <option value="unvisited"{% if sort == 'unvisited' %} selected{% endif %}>{{ t('entries.sort_unvisited') }}</option>
                <option value="most_visited"{% if sort == 'most_visited' %} selected{% endif %}>{{ t('entries.sort_most_visited') }}</option>
            </select>
        </label>
        {% if can_split %}
        <div class="layout-segmented" id="lexicon-mode-toggle" role="radiogroup" aria-label="{{ t('entries.mode_aria') }}">
            <button type="button" class="layout-seg-btn is-active" role="radio" aria-checked="true" data-layout-mode="split">{{ t('entries.mode_split') }}</button>
            <button type="button" class="layout-seg-btn" role="radio" aria-checked="false" data-layout-mode="ledger">{{ t('entries.mode_ledger') }}</button>
        </div>
        {% endif %}
    </div>
</div>

<div class="lexicon-workbench{% if can_split %} is-split{% endif %}" id="lexicon-workbench" data-can-split="{{ 'true' if can_split else 'false' }}">
    <div class="lexicon-list-pane" id="results">
        {% include "_entries_results.html.jinja" %}
    </div>
    {% if can_split %}
    <aside class="lexicon-detail-pane" id="lexicon-detail-pane" aria-live="polite">
        <p class="lexicon-detail-placeholder">{{ t('entries.select_prompt') }}</p>
    </aside>
    {% endif %}
</div>
</main>

<button type="button" class="back-to-top" id="back-to-top" aria-label="{{ t('entries.back_to_top') }}" hidden>&uarr;</button>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const results = document.getElementById("results");
        const workbench = document.getElementById("lexicon-workbench");
        const detailPane = document.getElementById("lexicon-detail-pane");
        const modeToggle = document.getElementById("lexicon-mode-toggle");
        if (!results) return;

        const canSplit = workbench && workbench.dataset.canSplit === "true" && Boolean(detailPane);
        let activeEntryId = null;
        let partialFetchController = null;
        let sheetListenersController = null;
        let dwellTimer = null;
        const visitedInSession = new Set();

        function getPreferredMode() {
            if (!canSplit) return "ledger";
            try {
                return localStorage.getItem("glossbook_lexicon_mode") === "ledger" ? "ledger" : "split";
            } catch (_) {
                return "split";
            }
        }

        function isSplitVisible() {
            if (!canSplit || !detailPane || !workbench.classList.contains("is-split")) return false;
            return window.getComputedStyle(detailPane).display !== "none";
        }

        function cancelDwellTimer() {
            if (dwellTimer) {
                clearTimeout(dwellTimer);
                dwellTimer = null;
            }
        }

        function scheduleDwellVisit(entryId) {
            cancelDwellTimer();
            if (!entryId || visitedInSession.has(String(entryId))) return;
            dwellTimer = setTimeout(() => {
                dwellTimer = null;
                if (document.visibilityState !== "visible" || String(activeEntryId) !== String(entryId)) return;
                visitedInSession.add(String(entryId));
                fetch("/quiz/" + encodeURIComponent(entryId) + "/seen", {
                    method: "POST",
                    headers: Object.assign({ Accept: "application/json" }, csrfHeaders()),
                })
                    .then(handleProtectedResponse)
                    .then((resp) => (resp.ok ? resp.json() : null))
                    .then((data) => {
                        if (data && data.recorded) {
                            const row = document.getElementById(String(entryId));
                            const vcCell = row ? row.querySelector(".visit-col") : null;
                            if (vcCell) {
                                const next = (Number(vcCell.textContent.trim()) || 0) + 1;
                                vcCell.textContent = String(next);
                                vcCell.classList.remove("visit-0", "visit-low", "visit-mid", "visit-high");
                                vcCell.classList.add(next === 0 ? "visit-0" : next <= 2 ? "visit-low" : next <= 4 ? "visit-mid" : "visit-high");
                            }
                        }
                    })
                    .catch(() => {});
            }, 3000);
        }

        function clearDetailPane(message) {
            cancelDwellTimer();
            if (partialFetchController) {
                partialFetchController.abort();
                partialFetchController = null;
            }
            if (sheetListenersController) {
                sheetListenersController.abort();
                sheetListenersController = null;
            }
            activeEntryId = null;
            if (!detailPane) return;
            detailPane.textContent = "";
            const p = document.createElement("p");
            p.className = "lexicon-detail-placeholder";
            p.textContent = message || uiText("select_prompt", null, "{{ t('entries.select_prompt') }}");
            detailPane.appendChild(p);
        }

        function decrementResultCounters({ definedAdded = false } = {}) {
            const countEl = document.getElementById("results-count");
            if (countEl) {
                const match = countEl.textContent.match(/^(\d+)(.*)$/);
                if (match) {
                    countEl.textContent = Math.max(0, Number(match[1]) - 1) + match[2];
                }
            }
            if (definedAdded || document.querySelector('input[name="needs_definition"]')) {
                const badge = document.getElementById("undefined-count-badge");
                if (badge) {
                    const nextUndef = Math.max(0, Number(badge.dataset.count || 0) - 1);
                    badge.dataset.count = String(nextUndef);
                    if (nextUndef > 0) {
                        badge.textContent = " (" + nextUndef + ")";
                    } else {
                        badge.remove();
                    }
                }
            }
        }

        function selectRow(row, { loadDetail = true, scrollIntoView = false } = {}) {
            if (!row) return;
            const prev = results.querySelector("tr.selected");
            if (prev && prev !== row) prev.classList.remove("selected");
            row.classList.add("selected");
            if (scrollIntoView) {
                row.scrollIntoView({ block: "nearest" });
            }
            if (loadDetail && isSplitVisible()) {
                loadEntryPartial(row.id);
            }
        }

        function loadEntryPartial(entryId, { force = false } = {}) {
            if (!isSplitVisible() || !entryId) return;
            if (!force && String(activeEntryId) === String(entryId)) return;

            cancelDwellTimer();
            stopWordPronunciation();
            if (partialFetchController) partialFetchController.abort();
            if (sheetListenersController) {
                sheetListenersController.abort();
                sheetListenersController = null;
            }

            activeEntryId = String(entryId);
            partialFetchController = new AbortController();
            const currentFetch = partialFetchController;

            detailPane.textContent = "";
            const loading = document.createElement("p");
            loading.className = "lexicon-detail-placeholder";
            loading.textContent = uiText("loading_sheet", null, "Loading entry…");
            detailPane.appendChild(loading);

            fetch("/entry/" + encodeURIComponent(entryId) + "?partial=1", {
                cache: "no-store",
                headers: { "X-Requested-With": "XMLHttpRequest" },
                signal: currentFetch.signal,
            })
                .then(handleProtectedResponse)
                .then((resp) => {
                    if (!resp.ok) throw new Error("HTTP " + resp.status);
                    return resp.text();
                })
                .then((html) => {
                    if (currentFetch.signal.aborted || String(activeEntryId) !== String(entryId)) return;
                    detailPane.innerHTML = html;
                    detailPane.scrollTop = 0;
                    const article = detailPane.querySelector("#entry-article");
                    if (article && typeof initEntrySheet === "function") {
                        sheetListenersController = new AbortController();
                        initEntrySheet(article, {
                            mode: "split",
                            signal: sheetListenersController.signal,
                            onUpdated: (meta) => {
                                const row = document.getElementById(String(entryId));
                                if (meta && meta.action === "edit-entry" && row) {
                                    const link = row.querySelector(".entry-col a");
                                    const audio = row.querySelector(".audio-btn");
                                    const ctx = row.querySelector(".context-col");
                                    if (link && typeof meta.word === "string") link.textContent = meta.word;
                                    if (audio && typeof meta.word === "string") audio.dataset.word = meta.word;
                                    if (ctx && typeof meta.context === "string") ctx.textContent = meta.context;
                                }
                                if (meta && meta.action === "add-definition" && document.querySelector('input[name="needs_definition"]')) {
                                    if (row) {
                                        const nextRow = row.nextElementSibling || row.previousElementSibling;
                                        row.remove();
                                        decrementResultCounters({ definedAdded: true });
                                        if (nextRow && nextRow.id) {
                                            selectRow(nextRow, { loadDetail: true });
                                        } else {
                                            clearDetailPane();
                                        }
                                        return;
                                    }
                                }
                                if (meta && meta.action === "bookmark") {
                                    refreshReviewBookmarkLink();
                                }
                                loadEntryPartial(entryId, { force: true });
                            },
                            onDeleted: (deletedId) => {
                                const row = document.getElementById(String(deletedId));
                                const nextRow = row ? (row.nextElementSibling || row.previousElementSibling) : null;
                                if (row) row.remove();
                                decrementResultCounters();
                                if (nextRow && nextRow.id) {
                                    selectRow(nextRow, { loadDetail: true });
                                } else {
                                    clearDetailPane();
                                }
                            },
                        });
                    }
                    scheduleDwellVisit(entryId);
                })
                .catch((err) => {
                    if (err && err.name === "AbortError") return;
                    clearDetailPane(uiText("load_sheet_error", null, "Could not load entry."));
                });
        }

        function ensureInitialSelection() {
            if (!isSplitVisible()) return;
            const hashId = window.location.hash ? window.location.hash.slice(1) : "";
            const hashRow = hashId ? document.getElementById(hashId) : null;
            const existingRow = activeEntryId ? document.getElementById(String(activeEntryId)) : null;
            const targetRow = (hashRow && results.contains(hashRow))
                ? hashRow
                : (existingRow && results.contains(existingRow))
                ? existingRow
                : results.querySelector("tbody tr[id]");
            if (targetRow) {
                selectRow(targetRow, { loadDetail: true });
            } else {
                clearDetailPane();
            }
        }

        function applyLayoutMode(mode) {
            if (!canSplit) return;
            const isSplit = mode !== "ledger";
            workbench.classList.toggle("is-split", isSplit);
            try {
                if (isSplit) localStorage.removeItem("glossbook_lexicon_mode");
                else localStorage.setItem("glossbook_lexicon_mode", "ledger");
            } catch (_) {}
            if (modeToggle) {
                modeToggle.querySelectorAll(".layout-seg-btn").forEach((btn) => {
                    const active = btn.dataset.layoutMode === (isSplit ? "split" : "ledger");
                    btn.classList.toggle("is-active", active);
                    btn.setAttribute("aria-checked", String(active));
                });
            }
            if (isSplit) {
                ensureInitialSelection();
            } else {
                clearDetailPane();
            }
        }

        if (modeToggle) {
            modeToggle.querySelectorAll(".layout-seg-btn").forEach((btn) => {
                btn.addEventListener("click", () => applyLayoutMode(btn.dataset.layoutMode));
            });
            applyLayoutMode(getPreferredMode());
        }

        if (canSplit && typeof ResizeObserver === "function") {
            const appMain = document.getElementById("app-main");
            if (appMain) {
                let wasVisible = isSplitVisible();
                new ResizeObserver(() => {
                    const nowVisible = isSplitVisible();
                    if (nowVisible && !wasVisible) {
                        ensureInitialSelection();
                    } else if (!nowVisible && wasVisible) {
                        clearDetailPane();
                    }
                    wasVisible = nowVisible;
                }).observe(appMain);
            }
        }

        document.addEventListener("keydown", (event) => {
            if (shouldIgnoreShortcut(event)) return;
            if (event.key === "D") {
                delete_selected_entry();
            } else if (event.key === "j" || event.key === "k") {
                const rows = Array.from(results.querySelectorAll("tbody tr[id]"));
                if (!rows.length) return;
                event.preventDefault();
                const current = results.querySelector("tbody tr.selected");
                let idx = current ? rows.indexOf(current) : -1;
                if (event.key === "j") {
                    idx = idx < rows.length - 1 ? idx + 1 : 0;
                } else {
                    idx = idx > 0 ? idx - 1 : rows.length - 1;
                }
                selectRow(rows[idx], { loadDetail: true, scrollIntoView: true });
            }
        });

        function toggleDefinitionCell(cell) {
            const preview = cell.querySelector(".definition-preview.is-expandable");
            if (!preview) return;
            const nowClamped = preview.classList.toggle("is-clamped");
            const btn = cell.querySelector(".definition-toggle");
            if (btn) {
                btn.setAttribute("aria-expanded", String(!nowClamped));
                btn.textContent = nowClamped
                    ? uiText("show_more", null, "Show more")
                    : uiText("show_less", null, "Show less");
            }
        }

        results.addEventListener("click", function (event) {
            const audioBtn = event.target.closest(".audio-btn");
            if (audioBtn) {
                event.stopPropagation();
                playWordPronunciation(audioBtn.dataset.word || "", audioBtn);
                return;
            }

            const toggleBtn = event.target.closest(".definition-toggle");
            if (toggleBtn) {
                event.stopPropagation();
                const cell = toggleBtn.closest("td");
                if (cell) toggleDefinitionCell(cell);
                return;
            }

            const preview = event.target.closest(".definition-preview.is-expandable");
            if (preview && !(window.getSelection && window.getSelection().toString())) {
                const cell = preview.closest("td");
                if (cell) toggleDefinitionCell(cell);
                return;
            }

            const row = event.target.closest("tr[id]");
            if (!row) return;

            const link = event.target.closest("a");
            if (link && isSplitVisible()) {
                if (!event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey && event.button === 0) {
                    event.preventDefault();
                    selectRow(row, { loadDetail: true });
                }
                return;
            }

            selectRow(row, { loadDetail: true });
        });

        function syncOverflowToggles() {
            results.querySelectorAll(".definition-preview.is-clamped").forEach((preview) => {
                const cell = preview.closest("td");
                const btn = cell ? cell.querySelector(".definition-toggle") : null;
                const actuallyClamped = preview.scrollHeight > preview.clientHeight + 2;
                preview.classList.toggle("is-expandable", actuallyClamped);
                if (btn) {
                    btn.hidden = !actuallyClamped;
                }
            });
        }

        let resizeTimer = null;
        window.addEventListener("resize", () => {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(syncOverflowToggles, 120);
        });

        initLiveSearch(results, () => {
            syncOverflowToggles();
            activeEntryId = null;
            ensureInitialSelection();
        });
        syncOverflowToggles();
        initBackToTop();
        refreshReviewBookmarkLink();
        flashIncomingHashTarget();
        ensureInitialSelection();

        window.delete_selected_entry = function delete_selected_entry() {
            const selectedRow = results.querySelector("tr.selected");
            if (!selectedRow) return;
            const selectedEntryId = selectedRow.id;
            const entryLink = selectedRow.querySelector(".entry-col a");
            const entryText = entryLink ? entryLink.textContent.trim() : selectedRow.firstElementChild.textContent.trim();
            confirmDialog(
                uiText(
                    "confirm_delete_entry_detail",
                    { id: selectedEntryId, entry: entryText },
                    "Delete this entry?\n\nID: " + selectedEntryId + "\nEntry: " + entryText
                ),
                { danger: true }
            ).then((confirmed) => {
                if (!confirmed) return;
                fetch("/delete_entry/" + selectedEntryId, {
                    method: "DELETE",
                    headers: csrfHeaders()
                }).then(handleProtectedResponse).then((resp) => {
                    if (resp.ok) {
                        const nextRow = selectedRow.nextElementSibling || selectedRow.previousElementSibling;
                        selectedRow.remove();
                        decrementResultCounters();
                        if (String(activeEntryId) === String(selectedEntryId)) {
                            if (nextRow && nextRow.id && isSplitVisible()) {
                                selectRow(nextRow, { loadDetail: true });
                            } else {
                                clearDetailPane();
                            }
                        }
                    }
                });
            });
        };
    });

    function initBackToTop() {
        const button = document.getElementById("back-to-top");
        const sentinel = document.getElementById("top");
        if (!button || !sentinel) return;

        button.addEventListener("click", function () {
            const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            window.scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
        });

        if ("IntersectionObserver" in window) {
            const observer = new IntersectionObserver((entries) => {
                button.hidden = entries[0].isIntersecting;
            });
            observer.observe(sentinel);
        } else {
            button.hidden = false;
        }
    }

    function initLiveSearch(results, onSwapped) {
        const form = document.querySelector(".search-form");
        const input = form && form.querySelector('input[name="q"]');
        if (!form || !input) return;

        const entriesOnlyInput = form.querySelector('input[name="entries_only"]');
        const showDefinitionInput = form.querySelector('input[name="show_definition"]');
        const showExampleInput = form.querySelector('input[name="show_example"]');
        const needsDefinitionInput = form.querySelector('input[name="needs_definition"]');
        const sortSelect = document.getElementById("entries-sort-select");
        const countEl = document.getElementById("results-count");
        const clearLink = document.getElementById("clear-search-link");
        const undefinedBadge = document.getElementById("undefined-count-badge");
        const tabs = {
            all: document.getElementById("tab-all"),
            entries_only: document.getElementById("tab-entries-only"),
            show_example: document.getElementById("tab-examples"),
            show_definition: document.getElementById("tab-definitions"),
            needs_definition: document.getElementById("tab-needs-definition"),
        };

        let debounceTimer = null;
        let abortController = null;

        input.addEventListener("input", function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(runLiveSearch, 300);
        });

        if (sortSelect) {
            sortSelect.addEventListener("change", function () {
                clearTimeout(debounceTimer);
                runLiveSearch();
            });
        }

        function runLiveSearch() {
            if (abortController) abortController.abort();
            abortController = new AbortController();

            const url = new URL(form.action, window.location.href);
            const query = input.value.trim();
            const sortVal = sortSelect ? sortSelect.value : "newest";
            if (query) url.searchParams.set("q", query);
            if (entriesOnlyInput) url.searchParams.set("entries_only", "true");
            if (showDefinitionInput) url.searchParams.set("show_definition", "true");
            if (showExampleInput) url.searchParams.set("show_example", "true");
            if (needsDefinitionInput) url.searchParams.set("needs_definition", "true");
            if (sortVal && sortVal !== "newest") url.searchParams.set("sort", sortVal);

            fetchJson(url, {
                headers: { "X-Requested-With": "XMLHttpRequest" },
                signal: abortController.signal,
            })
                .then((data) => applyResults(data, url, sortVal))
                .catch((err) => {
                    if (err.name !== "AbortError") console.error(err);
                });
        }

        function applyResults(data, url, sortVal) {
            results.innerHTML = data.results_html;
            if (typeof onSwapped === "function") onSwapped();
            if (countEl) {
                const countKey = data.matching
                    ? (data.count === 1 ? "entries_count_matching_one" : "entries_count_matching")
                    : (data.count === 1 ? "entries_count_plain_one" : "entries_count_plain");
                countEl.textContent = uiText(
                    countKey,
                    { n: data.count },
                    data.count + (data.matching ? (data.count === 1 ? " matching entry" : " matching entries") : (data.count === 1 ? " entry" : " entries"))
                );
            }
            if (clearLink) {
                clearLink.hidden = !data.matching;
                const clearUrl = new URL(clearLink.href, window.location.href);
                if (sortVal && sortVal !== "newest") {
                    clearUrl.searchParams.set("sort", sortVal);
                } else {
                    clearUrl.searchParams.delete("sort");
                }
                clearLink.href = clearUrl.toString();
            }
            if (undefinedBadge) undefinedBadge.hidden = data.matching;

            for (const tab of Object.values(tabs)) {
                if (!tab) continue;
                const tabUrl = new URL(tab.href, window.location.href);
                if (data.matching) {
                    tabUrl.searchParams.set("q", data.query);
                } else {
                    tabUrl.searchParams.delete("q");
                }
                if (sortVal && sortVal !== "newest") {
                    tabUrl.searchParams.set("sort", sortVal);
                } else {
                    tabUrl.searchParams.delete("sort");
                }
                tab.href = tabUrl.toString();
            }

            url.searchParams.delete("page");
            history.replaceState(null, "", url);
        }
    }

    window.addEventListener("pageshow", refreshReviewBookmarkLink);
    window.addEventListener("focus", refreshReviewBookmarkLink);
    document.addEventListener("visibilitychange", function () {
        if (!document.hidden) refreshReviewBookmarkLink();
    });

    function refreshReviewBookmarkLink() {
        fetchReviewBookmark().then(updateReviewBookmarkLink);
    }

    function fetchReviewBookmark() {
        return fetchJson("/review_bookmark").catch(() => ({ entry_id: null }));
    }

    function updateReviewBookmarkLink(data) {
        const resumeLink = document.getElementById("resume-bookmark-link");
        if (!resumeLink) return;
        resumeLink.hidden = !data.entry_id;
    }

    function flashResumeTarget(entryId) {
        const targetRow = document.getElementById(String(entryId));
        if (!targetRow) return;

        targetRow.classList.remove("resume-target-flash");
        void targetRow.offsetWidth;
        targetRow.classList.add("resume-target-flash");
        setTimeout(() => {
            targetRow.classList.remove("resume-target-flash");
        }, 1900);
    }

    function flashIncomingHashTarget() {
        const hash = window.location.hash;
        if (!hash) return;
        const entryId = hash.slice(1);
        if (!entryId || !document.getElementById(entryId)) return;
        flashResumeTarget(entryId);
    }
</script>

{% endblock body %}
