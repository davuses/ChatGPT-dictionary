{% extends "base.html.jinja" %}
{% from "_page_header.html.jinja" import page_header %}
{% block title -%}
{%- if entries_only -%}
Entries Only
{%- elif show_example -%}
Show Example
{%- else -%}
My Dictionary
{%- endif -%}
{%- endblock title %}

{% block body %}

{% macro view_qs(extra) %}{% if search_query %}{{ extra }}q={{ search_query | urlencode }}{% endif %}{% endmacro %}

{% set resume_link %}<a class="button button-ghost" id="resume-bookmark-link" href="/resume_review"{% if not review_bookmark_entry_id %} hidden{% endif %}>Resume from last mark</a>{% endset %}
{{ page_header(subtitle=(entries_count|string) ~ " " ~ ("matching " if search_query else "") ~ "entries", active="browse", id="top", extra_nav=resume_link, subtitle_id="results-count") }}

<form class="search-form" role="search" action="/entries" method="get">
    {% if entries_only %}<input type="hidden" name="entries_only" value="true">{% endif %}
    {% if show_example %}<input type="hidden" name="show_example" value="true">{% endif %}
    <input type="search"
        name="q"
        value="{{ search_query }}"
        placeholder="Search words, context, or examples&hellip;"
        aria-label="Search entries">
    <button class="button button-primary" type="submit">Search</button>
    <a class="button button-ghost" id="clear-search-link" href="/entries{% if entries_only %}?entries_only=true{% elif show_example %}?show_example=true{% endif %}"{% if not search_query %} hidden{% endif %}>Clear</a>
</form>

<nav class="view-tabs" aria-label="Entry views">
    <a class="view-tab {% if not entries_only and not show_example %}active{% endif %}"
        id="tab-all"
        href="/entries?{{ view_qs('') }}">All</a>
    <a class="view-tab {% if entries_only %}active{% endif %}"
        id="tab-entries-only"
        href="/entries?entries_only=true&{{ view_qs('') }}">Entries Only</a>
    <a class="view-tab {% if show_example %}active{% endif %}"
        id="tab-examples"
        href="/entries?show_example=true&{{ view_qs('') }}">Examples</a>
</nav>

<div id="results">
    {% include "_entries_results.html.jinja" %}
</div>

<div id="bottom">
</div>
<a href="#"
    class="float">
    <i class="my-float"
        style="font-size:20px">top</i>
</a>
<script>
    document.addEventListener("keydown", (event) => {
        if (event.key === "D") {
            delete_selected_entry()
        }

    });
    document.addEventListener("DOMContentLoaded", function () {
        // Bound to the #results wrapper, not .entries-table directly: live
        // search (below) replaces the table's HTML on every keystroke, and
        // a listener on the table node itself would be destroyed along with
        // it. #results is never replaced, only its contents, so delegating
        // here survives every swap.
        const results = document.getElementById("results");
        if (!results) return;

        results.addEventListener("click", function (event) {
            if (event.target.closest(".dynamic-delete-button")) return;

            const row = event.target.closest("tr[id]");
            if (!row) return;

            const previouslySelectedRow = document.querySelector("tr.selected");
            if (previouslySelectedRow && previouslySelectedRow !== row) {
                previouslySelectedRow.classList.remove("selected");
            }

            if (!previouslySelectedRow || previouslySelectedRow !== row) {
                row.classList.add("selected");
            }
        });

        initLiveSearch(results);
        refreshReviewBookmarkLink();
        flashIncomingHashTarget();
    });

    // Search-as-you-type: debounce keystrokes, fetch the same /entries
    // route with a header that asks for a JSON fragment instead of the
    // full page, and swap in the new table/pagination/count. Falls back
    // to the plain <form> GET submit (full page reload) if JS is off.
    function initLiveSearch(results) {
        const form = document.querySelector(".search-form");
        const input = form && form.querySelector('input[name="q"]');
        if (!form || !input) return;

        const entriesOnlyInput = form.querySelector('input[name="entries_only"]');
        const showExampleInput = form.querySelector('input[name="show_example"]');
        const countEl = document.getElementById("results-count");
        const clearLink = document.getElementById("clear-search-link");
        const tabs = {
            all: document.getElementById("tab-all"),
            entries_only: document.getElementById("tab-entries-only"),
            show_example: document.getElementById("tab-examples"),
        };

        let debounceTimer = null;
        let abortController = null;

        input.addEventListener("input", function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(runLiveSearch, 300);
        });

        function runLiveSearch() {
            if (abortController) abortController.abort();
            abortController = new AbortController();

            const url = new URL(form.action, window.location.href);
            const query = input.value.trim();
            if (query) url.searchParams.set("q", query);
            if (entriesOnlyInput) url.searchParams.set("entries_only", "true");
            if (showExampleInput) url.searchParams.set("show_example", "true");

            fetch(url, {
                headers: { "X-Requested-With": "XMLHttpRequest" },
                signal: abortController.signal,
                cache: "no-store",
            })
                .then((response) => response.json())
                .then((data) => applyResults(data, url))
                .catch((err) => {
                    if (err.name !== "AbortError") console.error(err);
                });
        }

        function applyResults(data, url) {
            results.innerHTML = data.results_html;
            if (countEl) {
                countEl.textContent =
                    data.count + (data.matching ? " matching entries" : " entries");
            }
            if (clearLink) clearLink.hidden = !data.matching;

            for (const tab of Object.values(tabs)) {
                if (!tab) continue;
                const tabUrl = new URL(tab.href, window.location.href);
                if (data.matching) {
                    tabUrl.searchParams.set("q", data.query);
                } else {
                    tabUrl.searchParams.delete("q");
                }
                tab.href = tabUrl.toString();
            }

            url.searchParams.delete("page");
            history.replaceState(null, "", url);
        }
    }

    window.addEventListener("pageshow", refreshReviewBookmarkLink);
    window.addEventListener("focus", refreshReviewBookmarkLink);
    document.addEventListener("visibilitychange", function () {
        if (!document.hidden) refreshReviewBookmarkLink();
    });

    function refreshReviewBookmarkLink() {
        fetchReviewBookmark().then(updateReviewBookmarkLink);
    }

    function fetchReviewBookmark() {
        return fetch("/review_bookmark", { cache: "no-store" })
            .then((response) => response.json())
            .catch(() => ({ entry_id: null }));
    }

    function updateReviewBookmarkLink(data) {
        const resumeLink = document.getElementById("resume-bookmark-link");
        if (!resumeLink) return;
        resumeLink.hidden = !data.entry_id;
    }

    function flashResumeTarget(entryId) {
        const targetRow = document.getElementById(String(entryId));
        if (!targetRow) return;

        targetRow.classList.remove("resume-target-flash");
        void targetRow.offsetWidth;
        targetRow.classList.add("resume-target-flash");
        setTimeout(() => {
            targetRow.classList.remove("resume-target-flash");
        }, 1900);
    }

    // Arriving here via a cross-page link (e.g. the dashboard's "Resume
    // from last mark" card) lands with the hash already set, so the
    // browser's native anchor-jump happens with no flash. Replicate the
    // in-page click behavior once the table is in the DOM.
    function flashIncomingHashTarget() {
        const hash = window.location.hash;
        if (!hash) return;
        const entryId = hash.slice(1);
        if (!entryId || !document.getElementById(entryId)) return;
        flashResumeTarget(entryId);
    }

    function delete_selected_entry() {
        const selectedRow = document.querySelector("tr.selected")
        if (!selectedRow) {
            return;
        }
        const selectedEntryId = selectedRow.id;
        const entryText = selectedRow.firstElementChild.textContent.trim();
        if (
            confirm("Delete this entry?\n\nID: " + selectedEntryId + "\nEntry: " + entryText)
        ) {
            fetch("/delete_entry/" + selectedEntryId, { method: "DELETE" }).then((Response) => {
                if (Response.ok) {
                    selectedRow.parentNode.removeChild(selectedRow);
                }
            });
        }
    };
</script>

{% endblock body %}
