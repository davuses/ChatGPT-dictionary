{% extends "base.html.jinja" %}
{% from "_page_header.html.jinja" import page_header with context %}
{% block title %}{{ title }}{% endblock title %}
{% block nav_active %}notes{% endblock nav_active %}

{% block body %}

{% set edit_link %}{% if not is_dir %}<a class="button button-ghost" href="/edit_note/{{ note_url_path }}" id="edit-note">{{ t('nav.edit') }}</a>{% endif %}{% endset %}
{{ page_header(title=title, active="notes", extra_nav=edit_link) }}

<main class="notes-shell">
    {% if toc_exist %}
    <div class="notes-mobile-bar">
        <button id="toggle-toc" class="button button-ghost" type="button" aria-expanded="false" aria-controls="notes-toc">☰ {{ t('nav.toc_toggle') }}</button>
    </div>
    {% endif %}
    <div class="notes-layout">
        {% if toc_exist %}
        <aside class="toc" id="notes-toc">
            {{ toc_html | safe }}
        </aside>
        {% endif %}
        <article class="notes-article">
            {% if is_dir %}
            <div class="tree-markdown markdown-body">
                {{ note_html | safe }}
            </div>
            {% else %}
            <div class="markdown-body">{{ note_html | safe }}</div>
            {% endif %}
        </article>
    </div>
</main>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.addEventListener("keydown", (event) => {
            if (shouldIgnoreShortcut(event)) return;
            if (event.key === "e") {
                const editLink = document.getElementById("edit-note");
                if (editLink) editLink.click();
            }
        });

        const toc = document.getElementById("notes-toc");
        const button = document.getElementById("toggle-toc");
        if (!toc || !button) return;

        button.addEventListener("click", () => {
            const visible = toc.classList.toggle("visible");
            button.setAttribute("aria-expanded", String(visible));
        });
    });
</script>

{% endblock body %}
