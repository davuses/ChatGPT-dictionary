{% extends "base.html.jinja" %}
{% block title %} {{ title }} {% endblock title %}

{% block body %}

<style>
    div {
        display: flex;
        align-items: baseline;
    }

    .toc {
        position: fixed;
        top: 50px;
        left: 0;
        max-height: 100%;
        width: 225px;
        overflow-y: auto;
        background-color: #f8f9fa;
        padding: 10px;
        box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
        transform: translateX(-100%);
        transition: transform 0.3s ease;
        z-index: 1000;
    }

    /* When visible */
    .toc.visible {
        transform: translateX(0);
    }

    /* Larger screens: show permanently */
    @media screen and (min-width: 1000px) {
        .toc {
            transform: translateX(0);
            position: sticky;
            width: auto;
            min-width: 200px;
            max-height: 80vh;
            box-shadow: none;
        }

        #toggle-toc {
            display: none;
        }
    }


    .toc ul {
        list-style: none;
        font-size: 16px;
        padding-left: 10px;
        position: relative;
        margin: 0px;
        font-family: Math;
    }

    .toc ul::before {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: 10px;
        width: 1px;
        background-color: #ccc;
    }

    .toc li {
        position: relative;

        margin-bottom: 10px;
        padding-left: 13px;
    }

    .toc li::before {
        content: "";
        position: absolute;
        top: 12px;
        left: 0;
        width: 10px;
        height: 1px;
        background-color: #ccc;
    }

    .toc a {
        text-decoration: none;
        color: #5186bf;
    }

    .toc a:hover {
        color: #297bd2;
        text-decoration: underline;
    }

    article {
        margin-left: 20px;
        padding: 20px;
    }

    .tree-markdown {
        font-family: math;
        background-color: #f8f8f8;
        padding: 1rem;
        line-height: 1;
        border-radius: 6px;
        flex-direction: column;
        font-size: 19px;
    }

    .tree-markdown h2 {
        font-size: 1.5rem;
        color: #2c3e50;
    }

    .tree-markdown h3 {
        color: #2c3e50;
    }

    .tree-markdown a {
        color: #007acc;
        text-decoration: none;
    }

    .tree-markdown a:hover {
        text-decoration: underline;
    }

    .tree-markdown li {
        margin-bottom: 5px;
    }
</style>

<a href="/notes/"
    style="margin-right: 30px; margin-left: 40px;">Notes Tree</a>
<a href="/"
    style="margin-right: 30px;">Dictionary</a>

{% if not is_dir %}
<a href="/edit_note/{{ request.path_params.note_path }}"
    id="edit-note">Edit this note</a>
{% endif %}

<script>
    document.addEventListener("keydown", (event) => {
        if (event.key === "e") {
            document.getElementById("edit-note").click();
        }
    })

</script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const toc = document.querySelector(".toc");
        const button = document.getElementById("toggle-toc");

        button.addEventListener("click", () => {
            toc.classList.toggle("visible");
        });
    });
</script>
<button id="toggle-toc"
    style="
    position: fixed;
    top: 10px;
    left: 10px;
    z-index: 1100;
    background-color: #ffffff;
    border: 1px solid #ccc;
    padding: 6px 12px;
    border-radius: 4px;
    cursor: pointer;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
">☰</button>
<div style="display: flex;">
    {% if toc_exist %}
    <div class="toc">
        {{ toc_html | safe }}
    </div>
    {% endif %}
    <article>
        {% if is_dir %}
        <div class="tree-markdown">
            {{ note_html | safe }}
        </div>
        {% else %}
        {{ note_html | safe }}
        {% endif %}
    </article>
</div>

{% endblock body %}