{% extends "base.html.jinja" %}
{% block title %} {{ title }} {% endblock title %}

{% block body %}

<style>
    .notes-layout,
    .toc,
    .tree-markdown {
        display: flex;
        align-items: baseline;
    }

    .toc {
        position: fixed;
        top: 50px;
        left: 0;
        max-height: 100%;
        width: 225px;
        overflow-y: auto;
        background-color: var(--surface);
        padding: 10px;
        box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
        transform: translateX(-100%);
        transition: transform 0.3s ease;
        z-index: 1000;
    }

    /* When visible */
    .toc.visible {
        transform: translateX(0);
    }

    #toggle-toc {
        position: fixed;
        top: 10px;
        left: 10px;
        z-index: 1100;
        background-color: #ffffff;
        border: 1px solid var(--border);
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
    }

    /* Larger screens: show permanently */
    @media screen and (min-width: 1000px) {
        .toc {
            transform: translateX(0);
            position: sticky;
            width: auto;
            min-width: 200px;
            max-height: 80vh;
            box-shadow: none;
        }

        #toggle-toc {
            display: none;
        }
    }


    .toc ul {
        list-style: none;
        font-size: 16px;
        padding-left: 10px;
        position: relative;
        margin: 0px;
        font-family: Math;
    }

    .toc ul::before {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: 10px;
        width: 1px;
        background-color: var(--border);
    }

    .toc li {
        position: relative;

        margin-bottom: 10px;
        padding-left: 13px;
    }

    .toc li::before {
        content: "";
        position: absolute;
        top: 12px;
        left: 0;
        width: 10px;
        height: 1px;
        background-color: var(--border);
    }

    .toc a {
        text-decoration: none;
        color: var(--link);
    }

    .toc a:hover {
        color: var(--accent-dark);
        text-decoration: underline;
    }

    article {
        margin-left: 20px;
        padding: 20px;
    }

    .tree-markdown {
        font-family: math;
        background-color: var(--surface);
        padding: 1rem;
        line-height: 1;
        border-radius: 6px;
        flex-direction: column;
        font-size: 19px;
    }

    .tree-markdown h2 {
        font-size: 1.5rem;
        color: var(--accent-dark);
    }

    .tree-markdown h3 {
        color: var(--accent-dark);
    }

    .tree-markdown a {
        color: var(--link);
        text-decoration: none;
    }

    .tree-markdown a:hover {
        text-decoration: underline;
    }

    .tree-markdown li {
        margin-bottom: 5px;
    }
</style>

<nav class="page-toolbar notes-nav" aria-label="Notes navigation">
    <div class="page-toolbar-actions">
        <a class="button button-ghost" href="/notes/">Notes Tree</a>
        <a class="button button-ghost" href="/entries">Dictionary</a>
        {% if not is_dir %}
        <a class="button button-primary" href="/edit_note/{{ request.path_params.note_path }}"
            id="edit-note">Edit</a>
        {% endif %}
    </div>
</nav>

<script>
    document.addEventListener("keydown", (event) => {
        if (event.key === "e") {
            const editLink = document.getElementById("edit-note");
            if (editLink) editLink.click();
        }
    });

    document.addEventListener("DOMContentLoaded", function () {
        const toc = document.querySelector(".toc");
        const button = document.getElementById("toggle-toc");
        if (!toc || !button) return;

        button.addEventListener("click", () => {
            toc.classList.toggle("visible");
        });
    });
</script>
{% if toc_exist %}
<button id="toggle-toc">☰</button>
{% endif %}
<div class="notes-layout">
    {% if toc_exist %}
    <div class="toc">
        {{ toc_html | safe }}
    </div>
    {% endif %}
    <article>
        {% if is_dir %}
        <div class="tree-markdown">
            {{ note_html | safe }}
        </div>
        {% else %}
        {{ note_html | safe }}
        {% endif %}
    </article>
</div>

{% endblock body %}
