<tr>
    <th>Entry</th>
    <th>Context</th>
    <th>Visit</th>
    <th>Mark</th> <!-- New header -->
</tr>
{% for display in entry_displays %}
<tr id="{{ display.entry.id }}">
    <td class="col-1"><label class="unselectable">-<span data-content=" "></span></label><a
            href="entry/{{ display.entry.id }}">{{ display.text }}</a></td>
    <td class="col-2">
        {{ display.context }}
    </td>
    <td class="visit-{{ display.entry.visit_count }}">{{ display.entry.visit_count }}</td>
    <td class="review-cell">
        {% if display.last_review_elapsed != "never" %}
        review: {{ display.last_review_elapsed }}
        {% endif %}
    </td>
</tr>
{% endfor %}
{% if last_review_entry_id %}
<a href="#{{last_review_entry_id}}" class="last-review-link">last review</a>
{% endif %}