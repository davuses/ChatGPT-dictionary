<tr>
    <th>Question</th>
    <th>Context</th>
    <th>Examples</th>
</tr>
{% for QD in q_list %}
<tr id="{{ QD.question.id }}">
    <td class="col-1"><label class="unselectable">-<span data-content=" "></span></label><a
            style="text-decoration: none;"
            href="question/{{ QD.question.id }}">{{ QD.q_text }}</a></td>
    <td class="col-2">
        {{ QD.q_context }}
    </td>
    {% if show_example %}
    <td class="col-2"> {{ QD.question.example }} </td>
    {% endif %}
</tr>
{% endfor %}