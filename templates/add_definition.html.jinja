{% extends "base.html.jinja" %}
{% block title %}Add Definition{% endblock title %}

{% block body %}
<nav class="page-toolbar" aria-label="Form navigation">
    <div class="page-toolbar-actions">
        <a class="button button-ghost" href="/entry/{{ entry_id }}">Entry</a>
        <a class="button button-ghost" href="/entries">Dictionary</a>
    </div>
</nav>
<main class="form-page">
<h1>Add Definition</h1>
<form method="post"
    action="/add_definition">
    <textarea name="definition_text"></textarea><br>
    <input value="{{ entry_id }}"
        name="entry_id"
        type="hidden">
    <div class="form-actions">
        <input type="submit"
            value="Submit">
    </div>
</form>
</main>
{% endblock body %}
