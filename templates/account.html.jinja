{% extends "base.html.jinja" %}
{% from "_page_header.html.jinja" import page_header with context %}
{% block title %}Account{% endblock title %}
{% block body_class %}page-narrow{% endblock body_class %}

{% block body %}
{{ page_header(subtitle="Signed in as " ~ current_user.username ~ (" (admin)" if is_admin else ""), active="account") }}

<main class="account-page">
    <section class="card">
        <h2>Export Dictionary</h2>
        <p class="page-subtitle">Download an offline copy of your {{ entry_count }} {{ "entry" if entry_count == 1 else "entries" }} (JSON includes <code>/inbox</code> page notes and visit stats; Markdown formats a clean study notebook).</p>
        <div class="form-actions">
            <a class="button button-primary" href="/account/export.json">Download JSON</a>
            <a class="button button-ghost" href="/account/export.md">Download Markdown</a>
        </div>
    </section>

    <section class="card" id="extension">
        <h2>Chrome Side Panel API Tokens</h2>
        <p class="page-subtitle">Generate a separate token per device (e.g. Laptop Chrome, Desktop Chrome). Tokens are only shown once when created.</p>

        <details class="extension-guide"{% if not api_tokens %} open{% endif %}>
            <summary>How to install the Chrome extension (v{{ extension_version }})</summary>
            <ol class="extension-steps">
                <li><a href="{{ extension_download_url }}" target="_blank" rel="noopener noreferrer">Download <code>glossbook-extension-v{{ extension_version }}.zip</code></a> and unzip it.</li>
                <li>Open <code>chrome://extensions</code> in Chrome and enable <strong>Developer mode</strong> (top right).</li>
                <li>Click <strong>Load unpacked</strong> and select the extracted folder (the one containing <code>manifest.json</code>).</li>
                <li>Generate a token below, click the Glossbook icon to open the Side Panel, open <strong>Settings</strong>, enter server URL <code>{{ server_url }}</code> and your token, then click <strong>Save &amp; test</strong>.</li>
            </ol>
        </details>

        {% if new_token %}
        <div class="secret-box" role="status">
            <p><strong>New token created{% if new_token_label %} ({{ new_token_label }}){% endif %}</strong> — copy it now; it won't be shown again:</p>
            <div class="secret-box-row">
                <input type="text" class="secret-input" id="new-api-token" value="{{ new_token }}" readonly>
                <button type="button" class="button button-primary copy-secret-btn" data-copy-target="new-api-token">Copy</button>
            </div>
        </div>
        {% endif %}

        <form class="inline-create-form" method="post" action="/account/tokens">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="text" name="label" placeholder="Device label (e.g. Laptop Chrome)" maxlength="64">
            <button class="button button-primary" type="submit">Generate token</button>
        </form>

        {% if api_tokens %}
        <table class="data-table admin-table">
            <thead>
                <tr>
                    <th>Label</th>
                    <th>Created</th>
                    <th>Last used</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for token in api_tokens %}
                <tr>
                    <td>{{ token.label }}</td>
                    <td>{{ how_long_ago(token.created_at) }}</td>
                    <td>{{ how_long_ago(token.last_used_at) }}</td>
                    <td>
                        <form class="inline-form" method="post" action="/account/tokens/{{ token.id }}/revoke" onsubmit="return confirm('Revoke this API token? Any extension using it will stop syncing.');">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                            <button class="button button-danger" type="submit">Revoke</button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p class="page-subtitle">No API tokens yet.</p>
        {% endif %}
    </section>

    <section class="card">
        <h2>Change Password</h2>
        {% if password_notice %}<p class="form-notice" role="status">{{ password_notice }}</p>{% endif %}
        {% if password_error %}<p class="form-error" role="alert">{{ password_error }}</p>{% endif %}
        <form class="login-form" method="post" action="/account/password">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <label for="current_password">Current password</label>
            <input id="current_password" name="current_password" type="password" autocomplete="current-password" required>
            <label for="new_password">New password (10–128 characters)</label>
            <input id="new_password" name="new_password" type="password" autocomplete="new-password" minlength="10" maxlength="128" required>
            <label for="confirm_password">Confirm new password</label>
            <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" minlength="10" maxlength="128" required>
            <div class="form-actions">
                <button class="button button-primary" type="submit">Update password</button>
            </div>
        </form>
    </section>
</main>

<script>
document.querySelectorAll(".copy-secret-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
        const input = document.getElementById(btn.dataset.copyTarget);
        if (!input) return;
        input.select();
        navigator.clipboard?.writeText(input.value).then(() => {
            btn.textContent = "Copied";
            setTimeout(() => { btn.textContent = "Copy"; }, 1800);
        }).catch(() => {});
    });
});
</script>
{% endblock body %}
