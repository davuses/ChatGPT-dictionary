{% extends "base.html.jinja" %}
{% from "_page_header.html.jinja" import page_header with context %}
{% block title %}{{ t('account.title') }}{% endblock title %}
{% block body_class %}page-narrow{% endblock body_class %}
{% block nav_active %}account{% endblock nav_active %}

{% block body %}
{{ page_header(title=t('account.title'), subtitle=t('account.subtitle_admin' if is_admin else 'account.subtitle_user', username=current_user.username), active="account") }}

<main class="account-page">
    <section class="editorial-section">
        <h2>{{ t('account.export_import_title') }}</h2>
        <p class="section-desc">{{ t('account.export_desc_one' if entry_count == 1 else 'account.export_desc_many', n=entry_count) }}</p>
        <div class="form-actions">
            <a class="button button-primary" href="/account/export.json">{{ t('account.download_json') }}</a>
            <a class="button" href="/account/export.md">{{ t('account.download_md') }}</a>
        </div>

        <hr class="account-divider">

        <h3 class="account-subheading">{{ t('account.import_title') }}</h3>
        <p class="section-desc">{{ t('account.import_desc') }}</p>
        {% if import_notice %}<p class="form-notice" role="status">{{ import_notice }}</p>{% endif %}
        {% if import_error %}<p class="form-error" role="alert">{{ import_error }}</p>{% endif %}
        <p class="form-error" id="import-drop-error" role="alert" hidden></p>
        <form class="import-form" method="post" action="/account/import" enctype="multipart/form-data">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <div class="file-dropzone" id="import-dropzone">
                <input id="import-file-input" class="file-dropzone-input" type="file" name="file" accept=".json,application/json" required>
                <label class="file-dropzone-label" for="import-file-input">
                    <svg class="file-dropzone-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                        <path d="M12 15V4m0 0-4 4m4-4 4 4M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span class="file-dropzone-empty" id="import-drop-empty">
                        <span class="file-dropzone-title">{{ t('account.import_drop_title') }}</span>
                        <span class="file-dropzone-hint">{{ t('account.import_drop_hint') }}</span>
                    </span>
                    <span class="file-dropzone-selected" id="import-drop-selected" hidden>
                        <strong class="file-dropzone-name" id="import-file-name"></strong>
                        <span class="file-dropzone-meta" id="import-file-size"></span>
                    </span>
                </label>
                <button type="button" class="button button-ghost button-sm file-dropzone-clear" id="import-file-clear" hidden>{{ t('account.import_clear_file') }}</button>
            </div>
            <label class="import-checkbox">
                <input type="checkbox" name="include_inbox" value="true" checked>
                <span>{{ t('account.import_include_inbox') }}</span>
            </label>
            <div class="form-actions">
                <button class="button" type="submit">{{ t('account.import_btn') }}</button>
            </div>
        </form>
    </section>

    <section class="editorial-section" id="extension">
        <h2>{{ t('account.ext_section_title') }} <span class="field-hint">v{{ extension_version }}</span></h2>
        <p class="section-desc">{{ t('account.ext_section_intro') }}</p>

        <ul class="extension-features">
            <li><strong>{{ t('account.ext_feat_web_title') }}</strong> {{ t('account.ext_feat_web_desc') }}</li>
            <li><strong>{{ t('account.ext_feat_yt_title') }}</strong> {{ t('account.ext_feat_yt_desc') }}</li>
            <li><strong>{{ t('account.ext_feat_lookup_title') }}</strong> {{ t('account.ext_feat_lookup_desc') }}</li>
            <li><strong>{{ t('account.ext_feat_notes_title') }}</strong> {{ t('account.ext_feat_notes_desc') }}</li>
        </ul>

        <details class="extension-guide"{% if not api_tokens %} open{% endif %}>
            <summary>{{ t('account.ext_guide_summary', version=extension_version) }}</summary>
            <ol class="extension-steps">
                <li><a href="{{ extension_download_url }}" target="_blank" rel="noopener noreferrer">{{ t('account.ext_step1_link', version=extension_version) }}</a> {{ t('account.ext_step1_after') }}</li>
                <li>{{ t('account.ext_step2_before') }} <code>chrome://extensions</code> {{ t('account.ext_step2_mid') }} <strong>{{ t('account.ext_step2_bold') }}</strong> {{ t('account.ext_step2_after') }}</li>
                <li>{{ t('account.ext_step3_before') }} <strong>{{ t('account.ext_step3_bold') }}</strong> {{ t('account.ext_step3_after') }} <code>manifest.json</code>{{ t('account.ext_step3_end') }}</li>
                <li>{{ t('account.ext_step4_before') }} <strong>{{ t('account.ext_step4_settings') }}</strong>{{ t('account.ext_step4_mid') }} <code>{{ server_url }}</code> {{ t('account.ext_step4_and') }} <strong>{{ t('account.ext_step4_save') }}</strong>{{ t('account.ext_step4_end') }}</li>
            </ol>
            <p class="field-hint"><strong>{{ t('account.ext_update_tip_title') }}</strong> {{ t('account.ext_update_tip_body') }}</p>
        </details>

        <hr class="account-divider">

        <h3 class="account-subheading">{{ t('account.tokens_title') }}</h3>
        <p class="section-desc">{{ t('account.tokens_desc') }}</p>

        {% if new_token %}
        <div class="secret-box" role="status">
            <p><strong>{{ t('account.new_token_title') }}{% if new_token_label %} ({{ new_token_label }}){% endif %}</strong> {{ t('account.new_token_hint') }}</p>
            <div class="secret-box-row">
                <input type="text" class="secret-input" id="new-api-token" value="{{ new_token }}" readonly>
                <button type="button" class="button button-primary copy-secret-btn" data-copy-target="new-api-token">{{ t('account.copy') }}</button>
            </div>
        </div>
        {% endif %}

        <form class="inline-create-form" method="post" action="/account/tokens">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="text" name="label" placeholder="{{ t('account.token_label_placeholder') }}" maxlength="64">
            <button class="button button-primary" type="submit">{{ t('account.generate_token') }}</button>
        </form>

        {% if api_tokens %}
        <div class="table-scroll">
        <table class="data-table admin-table">
            <thead>
                <tr>
                    <th>{{ t('account.col_label') }}</th>
                    <th>{{ t('account.col_created') }}</th>
                    <th>{{ t('account.col_last_used') }}</th>
                    <th>{{ t('account.col_action') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for token in api_tokens %}
                <tr>
                    <td>{{ token.label }}</td>
                    <td class="num-cell">{{ how_long_ago(token.created_at) }}</td>
                    <td class="num-cell">{{ how_long_ago(token.last_used_at) }}</td>
                    <td>
                        <form class="inline-form" method="post" action="/account/tokens/{{ token.id }}/revoke" data-confirm-key="confirm_revoke_token" data-confirm-danger="true">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                            <button class="button button-danger" type="submit">{{ t('account.revoke') }}</button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
        {% else %}
        <p class="section-desc">{{ t('account.no_tokens') }}</p>
        {% endif %}
    </section>

    <section class="editorial-section">
        <h2>{{ t('account.pw_title') }}</h2>
        {% if password_notice %}<p class="form-notice" role="status">{{ password_notice }}</p>{% endif %}
        {% if password_error %}<p class="form-error" role="alert">{{ password_error }}</p>{% endif %}
        <form class="login-form" method="post" action="/account/password">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <label for="current_password">{{ t('account.current_pw') }}</label>
            <input id="current_password" name="current_password" type="password" autocomplete="current-password" required>
            <label for="new_password">{{ t('auth.new_password') }}</label>
            <input id="new_password" name="new_password" type="password" autocomplete="new-password" minlength="10" maxlength="128" required>
            <label for="confirm_password">{{ t('auth.confirm_new_password') }}</label>
            <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" minlength="10" maxlength="128" required>
            <div class="form-actions">
                <button class="button button-primary" type="submit">{{ t('account.update_pw') }}</button>
            </div>
        </form>
    </section>
</main>

<script>
document.addEventListener("DOMContentLoaded", function () {
    function openExtensionGuideIfHash() {
        if (window.location.hash === "#extension") {
            const details = document.querySelector(".extension-guide");
            if (details) details.open = true;
        }
    }
    openExtensionGuideIfHash();
    window.addEventListener("hashchange", openExtensionGuideIfHash);

    document.querySelectorAll(".copy-secret-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
            const input = document.getElementById(btn.dataset.copyTarget);
            if (!input) return;
            input.select();
            navigator.clipboard?.writeText(input.value).then(() => {
                btn.textContent = uiText("copied", null, "Copied");
                setTimeout(() => { btn.textContent = uiText("copy", null, "Copy"); }, 1800);
            }).catch(() => {});
        });
    });

    const dropzone = document.getElementById("import-dropzone");
    const fileInput = document.getElementById("import-file-input");
    const emptyEl = document.getElementById("import-drop-empty");
    const selectedEl = document.getElementById("import-drop-selected");
    const nameEl = document.getElementById("import-file-name");
    const sizeEl = document.getElementById("import-file-size");
    const clearBtn = document.getElementById("import-file-clear");
    const dropErrEl = document.getElementById("import-drop-error");

    function formatBytes(bytes) {
        if (!bytes) return "0 B";
        if (bytes < 1024) return bytes + " B";
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
        return (bytes / (1024 * 1024)).toFixed(2) + " MB";
    }

    function syncSelectedFile() {
        if (!fileInput || !dropzone) return;
        const file = fileInput.files && fileInput.files[0];
        if (dropErrEl) dropErrEl.hidden = true;
        if (file) {
            const isJson = /\.json$/i.test(file.name) || file.type === "application/json";
            if (!isJson) {
                fileInput.value = "";
                dropzone.classList.remove("has-file");
                if (emptyEl) emptyEl.hidden = false;
                if (selectedEl) selectedEl.hidden = true;
                if (clearBtn) clearBtn.hidden = true;
                if (dropErrEl) {
                    dropErrEl.textContent = uiText("import_drop_invalid", null, "Please drop a .json file.");
                    dropErrEl.hidden = false;
                }
                return;
            }
            dropzone.classList.add("has-file");
            if (emptyEl) emptyEl.hidden = true;
            if (selectedEl) selectedEl.hidden = false;
            if (nameEl) nameEl.textContent = file.name;
            if (sizeEl) sizeEl.textContent = formatBytes(file.size);
            if (clearBtn) clearBtn.hidden = false;
        } else {
            dropzone.classList.remove("has-file");
            if (emptyEl) emptyEl.hidden = false;
            if (selectedEl) selectedEl.hidden = true;
            if (clearBtn) clearBtn.hidden = true;
        }
    }

    if (dropzone && fileInput) {
        fileInput.addEventListener("change", syncSelectedFile);
        if (clearBtn) {
            clearBtn.addEventListener("click", (event) => {
                event.preventDefault();
                event.stopPropagation();
                fileInput.value = "";
                syncSelectedFile();
            });
        }

        let dragDepth = 0;
        ["dragenter", "dragover"].forEach((evName) => {
            dropzone.addEventListener(evName, (event) => {
                event.preventDefault();
                event.stopPropagation();
                if (evName === "dragenter") dragDepth += 1;
                dropzone.classList.add("is-dragover");
            });
        });
        ["dragleave", "dragend"].forEach((evName) => {
            dropzone.addEventListener(evName, (event) => {
                event.preventDefault();
                event.stopPropagation();
                dragDepth = Math.max(0, dragDepth - 1);
                if (dragDepth === 0) dropzone.classList.remove("is-dragover");
            });
        });
        dropzone.addEventListener("drop", (event) => {
            event.preventDefault();
            event.stopPropagation();
            dragDepth = 0;
            dropzone.classList.remove("is-dragover");
            const files = event.dataTransfer && event.dataTransfer.files;
            if (!files || !files.length) return;
            const file = files[0];
            const isJson = /\.json$/i.test(file.name) || file.type === "application/json";
            if (!isJson) {
                if (dropErrEl) {
                    dropErrEl.textContent = uiText("import_drop_invalid", null, "Please drop a .json file.");
                    dropErrEl.hidden = false;
                }
                return;
            }
            if (typeof DataTransfer === "function") {
                const dt = new DataTransfer();
                dt.items.add(file);
                fileInput.files = dt.files;
                syncSelectedFile();
            }
        });
    }
});
</script>
{% endblock body %}
