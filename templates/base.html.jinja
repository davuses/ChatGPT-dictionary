<!DOCTYPE html>
<html lang="en">

<head>
    <title>{% block title %}{% endblock title %}</title>
    <meta name="viewport"
        content="width=device-width, initial-scale=1.0">
    {% if csrf_token %}<meta name="csrf-token" content="{{ csrf_token }}">{% endif %}
    <link rel="stylesheet"
        href="{{ static_url('style.css') }}" />
    <script src="{{ static_url('script.js') }}" defer></script>
    <meta name="theme-color" content="#1f6f8b">
    <link rel="icon"
        type="image/svg+xml"
        href="{{ static_url('favicon.svg') }}">
    <link rel="icon"
        type="image/x-icon"
        href="{{ static_url('favicon.ico') }}">
    <link rel="apple-touch-icon"
        href="{{ static_url('apple-touch-icon.png') }}">
    <link rel="manifest"
        href="{{ static_url('manifest.json') }}">
    {% if needs_editor or needs_markdown_css %}
    <link rel="stylesheet"
        href="{{ static_url('markdown-pc.css') }}"
        media="screen and (min-width: 600px)" />
    <link rel="stylesheet"
        href="{{ static_url('markdown-mobile.css') }}"
        media="screen and (max-width: 599px)" />
    {% endif %}
    {% if needs_editor %}
    <link rel="stylesheet"
        href="{{ static_url('font-awesome.min.css') }}">
    <link rel="stylesheet"
        href="{{ static_url('md-editor.min.css') }}">
    <script src="{{ static_url('md-editor.min.js') }}"></script>
    {% endif %}
    {% block head %}{% endblock head %}
</head>

{% set _body_class %}{% block body_class %}{% endblock body_class %}{% endset %}
<body{% if _body_class.strip() %} class="{{ _body_class.strip() }}"{% endif %}>
    {% block body%}

    {% endblock body %}

</body>
</html>
