{
  "manifest_version": 3,
  "name": "My Dictionary Side Panel",
  "version": "0.1.0",
  "description": "Per-page scratchpad notes and batch vocabulary capture for My Dictionary.",
  "permissions": [
    "sidePanel",
    "tabs",
    "contextMenus",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open My Dictionary Side Panel"
  },
  "commands": {
    "quick-jot": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Capture selection or YouTube line into My Dictionary"
    }
  }
}
